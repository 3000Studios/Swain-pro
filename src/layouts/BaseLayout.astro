---
import SEO from '../components/SEO.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  image?: string
  type?: 'website' | 'article' | 'profile'
  publishDate?: string
  tags?: string[]
  canonical?: string
}

const seoProps = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <SEO {...seoProps} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,900;1,400;1,600&family=Source+Sans+3:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      /* ── Intersection Observer: reveal classes ── */
      const revealClasses = ['reveal-up','reveal-left','reveal-right','reveal-scale','reveal-rotate','reveal-3d']

      const revealObs = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return
            const el = entry.target as HTMLElement
            el.classList.add('in-view')
            el.querySelectorAll('.skill-bar-fill').forEach((bar) => bar.classList.add('animate'))
            revealObs.unobserve(el)
          })
        },
        { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
      )

      document.querySelectorAll(revealClasses.map(c => `.${c}`).join(',')).forEach((el) =>
        revealObs.observe(el)
      )

      /* ── Auto 3D float-in on headings not already in a reveal wrapper ── */
      const revealSelector = revealClasses.map(c => `.${c}`).join(',')
      document.querySelectorAll<HTMLElement>('h1, h2').forEach((heading) => {
        if (!heading.closest(revealSelector)) {
          heading.classList.add('reveal-3d')
          revealObs.observe(heading)
        }
      })

      /* ── Legacy .reveal class ── */
      const legacyObs = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return
            const el = entry.target as HTMLElement
            el.classList.add('visible')
            el.querySelectorAll('.skill-bar-fill').forEach((bar) => bar.classList.add('animate'))
          })
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      )
      document.querySelectorAll('.reveal').forEach((el) => legacyObs.observe(el))

      /* ── Staggered grid children ── */
      const gridObs = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return
            const parent = entry.target
            parent.querySelectorAll('[data-stagger]').forEach((child, i) => {
              ;(child as HTMLElement).style.transitionDelay = `${i * 90}ms`
              child.classList.add('in-view')
            })
            gridObs.unobserve(parent)
          })
        },
        { threshold: 0.08, rootMargin: '0px 0px -50px 0px' }
      )
      document.querySelectorAll('[data-stagger-parent]').forEach((el) => gridObs.observe(el))

      /* ── Active nav link ── */
      const currentPath = window.location.pathname
      document.querySelectorAll('[data-nav-link]').forEach((link) => {
        const href = link.getAttribute('href')
        if (href === currentPath || (href !== '/' && currentPath.startsWith(href!))) {
          link.classList.add('active')
        }
      })

      /* ── Nav hide on scroll down, show on scroll up ── */
      const header = document.querySelector<HTMLElement>('.header-blur')
      let lastScrollY = 0
      let ticking = false
      window.addEventListener('scroll', () => {
        if (ticking) return
        ticking = true
        requestAnimationFrame(() => {
          const y = window.scrollY
          if (y > 120) {
            if (y > lastScrollY) header?.classList.add('nav-hidden')
            else header?.classList.remove('nav-hidden')
          } else {
            header?.classList.remove('nav-hidden')
          }
          lastScrollY = y
          ticking = false
        })
      }, { passive: true })
    </script>
  </body>
</html>
