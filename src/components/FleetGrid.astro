</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches
  const clamp = (v: number, lo: number, hi: number) => Math.min(Math.max(v, lo), hi)

  function initFleet(root: HTMLElement) {
    if (root.dataset.js) return
    root.dataset.js = 'on'

    const grid = root.querySelector<HTMLElement>('.fleet__grid')
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-fleet-card]'))
    const status = root.querySelector<HTMLElement>('[data-fleet-status]')
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'))

    // Staggered flip-in as each batch of cards scrolls into view.
    if ('IntersectionObserver' in window && !reduceMotion) {
      const enter = new IntersectionObserver(
        (entries) => {
          entries
            .filter((e) => e.isIntersecting)
            .forEach((e, n) => {
              const el = e.target as HTMLElement
              el.style.setProperty('--d', `${n * 85}ms`)
              el.classList.add('is-in')
              enter.unobserve(el)
              window.setTimeout(() => el.style.removeProperty('--d'), 900 + n * 85)
            })
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
      )
      cards.forEach((c) => enter.observe(c))
    } else {
      cards.forEach((c) => c.classList.add('is-in'))
    }

    // Touch screens: light up the card that sits in the middle of the screen.
    if (!finePointer && 'IntersectionObserver' in window) {
      const center = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.target.classList.toggle('is-active', e.isIntersecting)),
        { rootMargin: '-40% 0px -40% 0px', threshold: 0 },
      )
      cards.forEach((c) => center.observe(c))
    }

    // Mouse: 3D tilt, glare, spotlight and a reticle that tracks the pointer.
    if (finePointer && !reduceMotion) {
      cards.forEach((card) => {
        const frame = card.querySelector<HTMLElement>('[data-fleet-frame]')
        const shot = card.querySelector<HTMLElement>('[data-shot]')
        if (!frame) return
        let raf = 0
        card.addEventListener('pointermove', (ev) => {
          if (raf) return
          raf = window.requestAnimationFrame(() => {
            raf = 0
            const r = frame.getBoundingClientRect()
            const x = clamp((ev.clientX - r.left) / r.width, 0, 1)
            const y = clamp((ev.clientY - r.top) / r.height, 0, 1)
            card.style.setProperty('--ry', `${(x - 0.5) * 14}deg`)
            card.style.setProperty('--rx', `${(0.5 - y) * 11}deg`)
            card.style.setProperty('--mx', `${x * 100}%`)
            card.style.setProperty('--my', `${y * 100}%`)
            if (shot) {
              const s = shot.getBoundingClientRect()
              const hw = Math.max(s.width / 2 - 44, 0)
              const hh = Math.max(s.height / 2 - 44, 0)
              card.style.setProperty('--sx', `${clamp(ev.clientX - (s.left + s.width / 2), -hw, hw)}px`)
              card.style.setProperty('--sy', `${clamp(ev.clientY - (s.top + s.height / 2), -hh, hh)}px`)
            }
          })
        })
        card.addEventListener('pointerleave', () => {
          if (raf) window.cancelAnimationFrame(raf)
          raf = 0
          ;['--rx', '--ry', '--mx', '--my', '--sx', '--sy'].forEach((p) => card.style.removeProperty(p))
        })
      })
    }

    // Click / tap: shockwave + sparks from the exact spot.
    const burst = (card: HTMLElement, ev: MouseEvent) => {
      if (reduceMotion) return
      const fx = card.querySelector<HTMLElement>('[data-fx]')
      if (!fx) return
      const r = card.getBoundingClientRect()
      const fromKeyboard = ev.detail === 0
      const x = fromKeyboard ? r.width / 2 : clamp(ev.clientX - r.left, 0, r.width)
      const y = fromKeyboard ? r.height / 2 : clamp(ev.clientY - r.top, 0, r.height)
      const made: HTMLElement[] = []
      const add = (cls: string, vars: Record<string, string>) => {
        const el = document.createElement('span')
        el.className = cls
        Object.entries(vars).forEach(([k, v]) => el.style.setProperty(k, v))
        fx.append(el)
        made.push(el)
      }
      const pos = { '--x': `${x}px`, '--y': `${y}px` }
      add('fleet-card__ring', pos)
      add('fleet-card__ring fleet-card__ring--late', pos)
      const n = 14
      for (let k = 0; k < n; k++) {
        const a = (360 / n) * k + Math.random() * 18
        add('fleet-card__spark', { ...pos, '--a': `${a}deg`, '--dist': `${70 + Math.random() * 80}px` })
      }
      window.setTimeout(() => made.forEach((el) => el.remove()), 950)
    }

    const faceOf = (card: HTMLElement, side: 'front' | 'back') => card.querySelector<HTMLElement>(`[data-face="${side}"]`)

    const setFlipped = (card: HTMLElement, on: boolean) => {
      if (card.classList.contains('is-flipped') === on) return
      const front = faceOf(card, 'front')
      const back = faceOf(card, 'back')
      if (!front || !back) return
      const hiding = on ? front : back
      const showing = on ? back : front
      const hadFocus = hiding.contains(document.activeElement)

      card.classList.toggle('is-flipped', on)
      showing.inert = false
      hiding.inert = true
      front.querySelector('[data-flip]')?.setAttribute('aria-expanded', String(on))

      // Blurred screenshot behind the intel panel, loaded only on the first flip.
      if (on) {
        const ghost = back.querySelector<HTMLElement>('[data-ghost]')
        const img = front.querySelector<HTMLImageElement>('img')
        if (ghost && img && !ghost.style.backgroundImage) {
          ghost.style.backgroundImage = `url("${img.currentSrc || img.src}")`
        }
      }

      if (!reduceMotion) {
        card.classList.remove('is-pop')
        void card.offsetWidth
        card.classList.add('is-pop')
      }
      if (hadFocus) showing.querySelector<HTMLElement>('[data-flip]')?.focus({ preventScroll: true })
    }

    cards.forEach((card) =>
      card.addEventListener('animationend', (e) => {
        if (e.target === card) card.classList.remove('is-pop')
      }),
    )

    grid?.addEventListener('click', (ev) => {
      const target = ev.target as Element | null
      const card = target?.closest<HTMLElement>('[data-fleet-card]')
      if (!target || !card) return
      if (target.closest('a')) return // Launch links just open the site.
      const isButton = !!target.closest('[data-flip]')
      if (!isButton && window.getSelection()?.toString()) return // let people select text
      setFlipped(card, !card.classList.contains('is-flipped'))
      burst(card, ev)
    })

    root.addEventListener('keydown', (ev) => {
      if (ev.key !== 'Escape') return
      const card = (ev.target as Element | null)?.closest<HTMLElement>('[data-fleet-card].is-flipped')
      if (card) setFlipped(card, false)
    })

    // Category filters with animated show/hide.
    const timers = new WeakMap<HTMLElement, number>()
    const applyFilter = (key: string, label: string) => {
      let shown = 0
      cards.forEach((card) => {
        const match = key === 'all' || card.dataset.group === key
        const pending = timers.get(card)
        if (pending) window.clearTimeout(pending)
        if (match) {
          shown++
          card.hidden = false
          card.classList.add('is-in')
          window.requestAnimationFrame(() => card.classList.remove('is-out'))
        } else {
          setFlipped(card, false)
          if (reduceMotion) {
            card.hidden = true
          } else {
            card.classList.add('is-out')
            timers.set(card, window.setTimeout(() => (card.hidden = true), 320))
          }
        }
      })
      if (status) {
        status.textContent = key === 'all' ? `Showing all ${shown} live sites` : `Showing ${shown} of ${cards.length}: ${label}`
      }
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)))
        applyFilter(chip.dataset.filter ?? 'all', chip.dataset.label ?? '')
      })
    })
  }

  document.querySelectorAll<HTMLElement>('[data-fleet]').forEach(initFleet)
</script>
