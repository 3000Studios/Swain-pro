---
// "Fleet" HUD cards for every live site. No fake browser windows: each card is an
// angular holo panel with a spinning neon edge, target-lock brackets, a tracking
// reticle, scan sweep, glitch title, 3D tilt + glare on hover (auto-activates when
// centered on touch screens), and a click/tap that fires a shockwave and flips the
// card to a radar "site intel" back. Category filters animate cards in and out.
// Works without JS (front faces only, links work) and respects prefers-reduced-motion.
import type { Domain } from '../data/domains'

interface Props {
  sites: Domain[]
  /** Human date the screenshots were captured, e.g. "November 24, 2026". */
  capturedLabel: string
  /** Unique id for this grid instance (used for aria wiring). */
  id?: string
}

const { sites, capturedLabel, id = 'fleet' } = Astro.props

const GROUPS = [
  { key: 'studio', label: 'Studio & Games', cats: ['Studio', 'Gaming', 'Music'], hue: '#7cff5b' },
  { key: 'ai', label: 'AI & SaaS', cats: ['AI SaaS', 'AI Tools', 'Growth Tools'], hue: '#82f7ff' },
  { key: 'commerce', label: 'Commerce & Money', cats: ['Commerce', 'FinTech'], hue: '#ffd27a' },
  { key: 'local', label: 'Local & Services', cats: ['Local Business', 'Services', 'Civic Tech'], hue: '#46f2c2' },
  { key: 'content', label: 'Content & Fun', cats: ['Content', 'Community', 'Novelty'], hue: '#ff6f91' },
  { key: 'personal', label: 'Personal & Family', cats: ['Portfolio', 'Family'], hue: '#b79cff' },
] as const

type Group = (typeof GROUPS)[number]
const groupOf = (category: string): Group => GROUPS.find((g) => (g.cats as readonly string[]).includes(category)) ?? GROUPS[1]
const hostOf = (url: string) => new URL(url).host.replace(/^www\./, '')

const groups = GROUPS.map((g) => ({
  ...g,
  count: sites.filter((s) => groupOf(s.category).key === g.key).length,
})).filter((g) => g.count > 0)
---

<div class="fleet" data-fleet id={id}>
  <div class="fleet__bar" role="toolbar" aria-label="Filter sites by type" aria-controls={`${id}-grid`}>
    <button type="button" class="fleet__chip" data-filter="all" data-label="All" aria-pressed="true" style="--hue:#e9fbff">
      All <span class="fleet__chip-count">{sites.length}</span>
    </button>
    {groups.map((g) => (
      <button type="button" class="fleet__chip" data-filter={g.key} data-label={g.label} aria-pressed="false" style={`--hue:${g.hue}`}>
        <span class="fleet__chip-dot" aria-hidden="true"></span>
        {g.label} <span class="fleet__chip-count">{g.count}</span>
      </button>
    ))}
    <p class="fleet__status" aria-live="polite" data-fleet-status>Showing all {sites.length} live sites</p>
    <p class="fleet__hint">Hover to lock on. Click or tap a card to flip it.</p>
  </div>

  <ul class="fleet__grid" id={`${id}-grid`} role="list">
    {sites.map((site, i) => {
      const g = groupOf(site.category)
      const host = hostOf(site.url)
      const idx = String(i + 1).padStart(2, '0')
      const backId = `${id}-intel-${i}`
      return (
        <li class="fleet-card" data-fleet-card data-group={g.key} style={`--hue:${g.hue}`}>
          <div class="fleet-card__frame" data-fleet-frame>
            <span class="fleet-card__aura" aria-hidden="true"></span>
            <span class="fleet-card__lock" aria-hidden="true"><i></i><i></i><i></i><i></i></span>

            <div class="fleet-card__flip">
              <div class="fleet-card__face fleet-card__face--front" data-face="front">
                <div class="fleet-card__panel">
                  <div class="fleet-card__shot" data-shot>
                    {site.screenshot ? (
                      <img src={site.screenshot} alt="" width="1200" height="750" loading="lazy" decoding="async" />
                    ) : (
                      <span class="fleet-card__mono">{host}</span>
                    )}
                    <span class="fleet-card__lines" aria-hidden="true"></span>
                    <span class="fleet-card__scan" aria-hidden="true"></span>
                    <span class="fleet-card__glare" aria-hidden="true"></span>
                    <span class="fleet-card__reticle" aria-hidden="true"></span>
                    <span class="fleet-card__hud fleet-card__hud--live"><span class="fleet-card__pulse" aria-hidden="true"></span>Live</span>
                    <span class="fleet-card__hud fleet-card__hud--host">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-1V7a5 5 0 0 0-5-5Zm-3 8V7a3 3 0 1 1 6 0v3H9Z" /></svg>
                      <span class="fleet-card__hud-text">{host}</span>
                    </span>
                  </div>

                  <div class="fleet-card__body">
                    <div class="fleet-card__meta">
                      <span class="fleet-card__idx">{idx}</span>
                      <span class="fleet-card__cat">{site.category}</span>
                    </div>
                    <h3 class="fleet-card__name">{site.name}</h3>
                    <p class="fleet-card__desc">{site.description}</p>
                    <div class="fleet-card__actions">
                      <a class="fleet-card__go" href={site.url} target="_blank" rel="noopener noreferrer">
                        Launch site
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M9 7h8v8" /></svg>
                        <span class="sr-only"> {site.name} (opens in a new tab)</span>
                      </a>
                      <button type="button" class="fleet-card__flipbtn" data-flip aria-expanded="false" aria-controls={backId}>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M4 12a8 8 0 0 1 13.7-5.6L20 8.7M20 4v4.7h-4.7M20 12a8 8 0 0 1-13.7 5.6L4 15.3M4 20v-4.7h4.7" /></svg>
                        Intel<span class="sr-only"> on {site.name}</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>

              <div class="fleet-card__face fleet-card__face--back" data-face="back" id={backId} inert>
                <div class="fleet-card__panel fleet-card__panel--back">
                  <span class="fleet-card__ghost" data-ghost aria-hidden="true"></span>
                  <span class="fleet-card__radar" aria-hidden="true"></span>
                  <div class="fleet-card__intel">
                    <p class="fleet-card__intel-tag" style="--i:0">Site intel // {idx}</p>
                    <p class="fleet-card__intel-name" style="--i:1">{site.name}</p>
                    <dl class="fleet-card__stats" style="--i:2">
                      <div><dt>Host</dt><dd>{host}</dd></div>
                      <div><dt>Sector</dt><dd>{g.label}</dd></div>
                      <div><dt>Type</dt><dd>{site.category}</dd></div>
                      <div><dt>Status</dt><dd class="fleet-card__online"><span class="fleet-card__pulse" aria-hidden="true"></span>Online</dd></div>
                    </dl>
                    <p class="fleet-card__intel-desc" style="--i:3">{site.description}</p>
                    <div class="fleet-card__actions" style="--i:4">
                      <a class="fleet-card__go" href={site.url} target="_blank" rel="noopener noreferrer">
                        Launch site
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M9 7h8v8" /></svg>
                        <span class="sr-only"> {site.name} (opens in a new tab)</span>
                      </a>
                      <button type="button" class="fleet-card__flipbtn" data-flip>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M10 6 4 12l6 6M4 12h16" /></svg>
                        Back<span class="sr-only"> to the {site.name} card</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <span class="fleet-card__fx" data-fx aria-hidden="true"></span>
        </li>
      )
    })}
  </ul>

  <p class="fleet__note">Every site above was opened and screenshotted live on {capturedLabel}.</p>
</div>

<style>
  @property --fc-angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  /* ── Filter bar ── */
  .fleet__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 2.25rem;
  }
  .fleet__chip {
    --hue: #82f7ff;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-dim);
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.1);
    cursor: pointer;
    transition: color 0.25s, background 0.25s, border-color 0.25s, box-shadow 0.25s, transform 0.25s;
  }
  .fleet__chip:hover {
    color: #fff;
    border-color: color-mix(in srgb, var(--hue) 55%, transparent);
    transform: translateY(-1px);
  }
  .fleet__chip:focus-visible {
    outline: 2px solid var(--hue);
    outline-offset: 2px;
  }
  .fleet__chip[aria-pressed='true'] {
    color: #05060a;
    background: linear-gradient(120deg, var(--hue), color-mix(in srgb, var(--hue) 55%, #ffffff));
    border-color: transparent;
    box-shadow: 0 0 24px color-mix(in srgb, var(--hue) 45%, transparent);
  }
  .fleet__chip-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--hue);
    box-shadow: 0 0 10px var(--hue);
  }
  .fleet__chip[aria-pressed='true'] .fleet__chip-dot {
    background: #05060a;
    box-shadow: none;
  }
  .fleet__chip-count {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.28);
  }
  .fleet__chip[aria-pressed='false'] .fleet__chip-count {
    background: rgba(255, 255, 255, 0.07);
  }
  .fleet__status,
  .fleet__hint {
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .fleet__status {
    flex: 1 1 auto;
  }
  .fleet__hint {
    color: #82f7ff;
  }
  .fleet:not([data-js]) .fleet__hint {
    display: none;
  }

  /* ── Grid ── */
  .fleet__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 640px) {
    .fleet__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1100px) {
    .fleet__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.1rem; }
  }
  .fleet__note {
    margin-top: 2.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    text-align: center;
  }

  /* ── Card shell ── */
  .fleet-card {
    --hue: #82f7ff;
    --rx: 0deg;
    --ry: 0deg;
    --mx: 50%;
    --my: 50%;
    --sx: 0px;
    --sy: 0px;
    --cut: 18px;
    position: relative;
    perspective: 1300px;
    transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .fleet-card[hidden] {
    display: none !important;
  }
  .fleet-card.is-out {
    opacity: 0;
    transform: scale(0.9) translateY(14px);
  }
  .fleet-card.is-pop {
    animation: fc-pop 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes fc-pop {
    0% { transform: scale(1); }
    28% { transform: scale(0.94); }
    62% { transform: scale(1.03); }
    100% { transform: scale(1); }
  }
  /* Entrance only when JS is running, so no-JS visitors always see the cards. */
  .fleet[data-js] .fleet-card:not(.is-in) .fleet-card__frame {
    opacity: 0;
    transform: translateY(46px) rotateX(18deg) scale(0.96);
  }

  .fleet-card__frame {
    position: relative;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition:
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.7s ease;
    transition-delay: var(--d, 0ms), var(--d, 0ms);
    will-change: transform;
  }
  .fleet-card:hover .fleet-card__frame {
    transition-delay: 0ms;
  }

  /* Soft colored glow that floats behind the card. */
  .fleet-card__aura {
    position: absolute;
    inset: -7% -5%;
    pointer-events: none;
    background: radial-gradient(58% 52% at 50% 58%, color-mix(in srgb, var(--hue) 42%, transparent), transparent 72%);
    opacity: 0;
    transform: translateZ(-60px);
    transition: opacity 0.5s ease;
  }

  /* Target-lock brackets that snap onto the corners. */
  .fleet-card__lock {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transform: translateZ(40px);
    z-index: 4;
  }
  .fleet-card__lock i {
    position: absolute;
    width: 24px;
    height: 24px;
    border: 2px solid color-mix(in srgb, var(--hue) 85%, #ffffff);
    filter: drop-shadow(0 0 6px var(--hue));
    opacity: 0;
    transition:
      transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.3s ease;
  }
  .fleet-card__lock i:nth-child(1) { top: -8px; left: -8px; border-right: 0; border-bottom: 0; transform: translate(-14px, -14px); }
  .fleet-card__lock i:nth-child(2) { top: -8px; right: -8px; border-left: 0; border-bottom: 0; transform: translate(14px, -14px); }
  .fleet-card__lock i:nth-child(3) { bottom: -8px; left: -8px; border-right: 0; border-top: 0; transform: translate(-14px, 14px); }
  .fleet-card__lock i:nth-child(4) { bottom: -8px; right: -8px; border-left: 0; border-top: 0; transform: translate(14px, 14px); }

  /* ── Flip + faces ── */
  .fleet-card__flip {
    position: relative;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.9s cubic-bezier(0.3, 1.4, 0.45, 1);
  }
  .fleet-card.is-flipped .fleet-card__flip {
    transform: rotateY(180deg);
  }
  .fleet-card__face {
    height: 100%;
    padding: 1.5px;
    cursor: pointer;
    clip-path: polygon(var(--cut) 0, 100% 0, 100% calc(100% - var(--cut)), calc(100% - var(--cut)) 100%, 0 100%, 0 var(--cut));
    background: conic-gradient(
      from var(--fc-angle),
      color-mix(in srgb, var(--hue) 90%, transparent),
      rgba(255, 255, 255, 0.07) 22%,
      rgba(111, 124, 255, 0.75) 45%,
      rgba(255, 255, 255, 0.07) 68%,
      color-mix(in srgb, var(--hue) 90%, transparent)
    );
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    animation: fc-spin 3.4s linear infinite paused;
  }
  .fleet-card__face--back {
    position: absolute;
    inset: 0;
    transform: rotateY(180deg);
  }
  .fleet:not([data-js]) .fleet-card__face--back {
    display: none;
  }
  @keyframes fc-spin {
    to { --fc-angle: 360deg; }
  }

  .fleet-card__panel {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    clip-path: polygon(
      calc(var(--cut) - 0.6px) 0,
      100% 0,
      100% calc(100% - var(--cut) + 0.6px),
      calc(100% - var(--cut) + 0.6px) 100%,
      0 100%,
      0 calc(var(--cut) - 0.6px)
    );
    background:
      linear-gradient(165deg, #0d1222 0%, #080b16 55%, #06070d 100%);
  }
  /* Pointer spotlight across the whole panel. */
  .fleet-card__panel::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(circle at var(--mx) var(--my), color-mix(in srgb, var(--hue) 16%, transparent), transparent 46%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  /* ── Hover / focus / centered-on-touch states ── */
  .fleet-card:hover .fleet-card__face,
  .fleet-card:focus-within .fleet-card__face,
  .fleet-card.is-active .fleet-card__face,
  .fleet-card.is-flipped .fleet-card__face {
    animation-play-state: running;
  }
  .fleet-card:hover .fleet-card__aura,
  .fleet-card:focus-within .fleet-card__aura,
  .fleet-card.is-active .fleet-card__aura,
  .fleet-card.is-flipped .fleet-card__aura {
    opacity: 1;
  }
  .fleet-card:hover .fleet-card__lock i,
  .fleet-card:focus-within .fleet-card__lock i,
  .fleet-card.is-active .fleet-card__lock i {
    opacity: 1;
    transform: translate(0, 0);
  }
  .fleet-card:hover .fleet-card__panel::after,
  .fleet-card.is-active .fleet-card__panel::after {
    opacity: 1;
  }

  /* ── Screenshot ── */
  .fleet-card__shot {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid color-mix(in srgb, var(--hue) 28%, transparent);
    background:
      radial-gradient(120% 90% at 20% 0%, color-mix(in srgb, var(--hue) 25%, transparent), transparent 60%),
      #05060a;
  }
  .fleet-card__shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transform: scale(1.02);
    transform-origin: 50% 0%;
    translate: 0 0;
    filter: saturate(1.02) contrast(1.02);
    transition:
      transform 1.6s cubic-bezier(0.16, 1, 0.3, 1),
      translate 0.35s ease-out,
      filter 0.6s ease;
  }
  .fleet-card:hover .fleet-card__shot img,
  .fleet-card.is-active .fleet-card__shot img {
    transform: scale(1.13);
    translate: calc((50% - var(--mx)) * 0.05) calc((50% - var(--my)) * 0.04);
    filter: saturate(1.18) contrast(1.06);
  }
  .fleet-card__mono {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(1rem, 3.2vw, 1.35rem);
    color: #fff;
    text-shadow: 0 0 22px var(--hue);
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 26px 26px;
  }
  .fleet-card__lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.18) 0 1px, transparent 1px 3px);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .fleet-card__scan {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 38%;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--hue) 22%, transparent) 70%,
      color-mix(in srgb, var(--hue) 85%, #ffffff) 98%,
      transparent 100%
    );
    mix-blend-mode: screen;
    opacity: 0;
    transform: translateY(-110%);
  }
  .fleet-card__glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at var(--mx) var(--my), rgba(255, 255, 255, 0.3), transparent 42%),
      linear-gradient(115deg, transparent 30%, color-mix(in srgb, var(--hue) 18%, transparent) 48%, transparent 66%);
    mix-blend-mode: overlay;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .fleet-card:hover .fleet-card__lines,
  .fleet-card.is-active .fleet-card__lines,
  .fleet-card:hover .fleet-card__glare,
  .fleet-card.is-active .fleet-card__glare {
    opacity: 1;
  }
  .fleet-card:hover .fleet-card__scan,
  .fleet-card.is-active .fleet-card__scan {
    opacity: 1;
    animation: fc-scan 2.2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  @keyframes fc-scan {
    0% { transform: translateY(-110%); }
    100% { transform: translateY(290%); }
  }

  /* Tracking reticle that follows the pointer over the screenshot. */
  .fleet-card__reticle {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    width: 76px;
    height: 76px;
    margin: -38px 0 0 -38px;
    pointer-events: none;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--hue) 80%, #ffffff);
    box-shadow:
      0 0 18px color-mix(in srgb, var(--hue) 55%, transparent),
      inset 0 0 14px color-mix(in srgb, var(--hue) 35%, transparent);
    opacity: 0;
    translate: var(--sx) var(--sy);
    transform: scale(1.9) rotate(-120deg);
    transition:
      opacity 0.35s ease,
      transform 0.65s cubic-bezier(0.34, 1.56, 0.64, 1),
      translate 0.18s ease-out;
  }
  .fleet-card__reticle::before,
  .fleet-card__reticle::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
  }
  .fleet-card__reticle::before {
    width: 1.5px;
    height: 112px;
    margin: -56px 0 0 -0.75px;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--hue) 85%, #ffffff) 0 16px,
      transparent 16px 50px,
      color-mix(in srgb, var(--hue) 85%, #ffffff) 50px 62px,
      transparent 62px 96px,
      color-mix(in srgb, var(--hue) 85%, #ffffff) 96px
    );
  }
  .fleet-card__reticle::after {
    width: 112px;
    height: 1.5px;
    margin: -0.75px 0 0 -56px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--hue) 85%, #ffffff) 0 16px,
      transparent 16px 50px,
