---
const serviceLinks = [
  { href: '/services#ai-development', label: 'AI Development' },
  { href: '/services#automation', label: 'Automation Engineering' },
  { href: '/services#llm-integration', label: 'LLM Integration' },
  { href: '/services#consulting', label: 'AI Consulting' },
  { href: '/services#business-analysis', label: 'Business Analysis' },
]

const portfolioLinks = [
  { href: '/projects', label: 'Projects' },
  { href: '/case-studies', label: 'Case Studies' },
  { href: '/domains', label: 'Domains & Ventures' },
  { href: '/resume', label: 'Resume' },
  { href: '/blog', label: 'Blog' },
]

const year = new Date().getFullYear()
import FooterAura from './backgrounds/FooterAura.tsx'
---

<footer class="relative z-10 overflow-hidden section-dark border-t border-white/10">
  <FooterAura client:load />
  <div
    aria-hidden="true"
    class="pointer-events-none absolute bottom-0 right-4 sm:right-8 z-0 flex items-end gap-1.5 opacity-60"
  >
    <div
      class="w-14 sm:w-16 h-10 sm:h-12 rounded-t-xl bg-gradient-to-b from-[rgba(130,247,255,0.72)] to-[rgba(111,124,255,0.12)] border border-[rgba(130,247,255,0.18)]"
    >
    </div>
    <div
      class="w-9 sm:w-10 h-7 sm:h-8 rounded-t-lg bg-gradient-to-b from-[rgba(183,156,255,0.55)] to-[rgba(55,43,21,0.08)] border border-[rgba(130,247,255,0.14)]"
    >
    </div>
    <div
      class="w-9 sm:w-10 h-7 sm:h-8 rounded-t-lg bg-gradient-to-b from-[rgba(96,109,243,0.55)] to-[rgba(55,43,21,0.08)] border border-[rgba(130,247,255,0.14)]"
    >
    </div>
  </div>
  <!-- Top strip with gold divider glow -->
  <div class="relative z-10 divider-gold"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 mb-14">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-flex items-center gap-3 mb-5 group" aria-label="Mr. Swain Home">
          <div
          class="w-10 h-10 rounded-xl metallic gloss-sweep flex items-center justify-center font-mono font-bold text-[var(--color-gold)] text-sm border border-[var(--color-border-glow)] relative"
          >
            JS
          </div>
          <div>
            <span class="block font-display font-semibold text-[var(--color-text)] text-sm"
              >Mr. Swain</span
            >
            <span
              class="block font-mono text-[0.58rem] text-[var(--color-gold)] tracking-widest uppercase"
              >Atlanta, GA</span
            >
          </div>
        </a>
        <p class="text-sm text-[var(--color-muted)] leading-relaxed mb-6">
          Building scalable AI systems, automation workflows, and LLM integrations that solve real
          business problems and ship to production.
        </p>
        <div class="flex gap-3">
          <a
            href="https://www.linkedin.com/in/mrjwswain/"
            target="_blank"
            rel="noopener noreferrer"
          class="p-2 rounded-full border border-white/10 bg-white/[0.03] text-[var(--color-muted)] hover:text-[var(--color-gold)] hover:border-[var(--color-border-glow)] transition-all hover:scale-110 active:scale-95"
            aria-label="LinkedIn profile"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </a>
          <a
            href="https://github.com/3000Studios"
            target="_blank"
            rel="noopener noreferrer"
          class="p-2 rounded-full border border-white/10 bg-white/[0.03] text-[var(--color-muted)] hover:text-[var(--color-gold)] hover:border-[var(--color-border-glow)] transition-all hover:scale-110 active:scale-95"
            aria-label="GitHub profile"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h3
          class="font-mono text-[0.65rem] font-semibold tracking-[0.14em] text-[var(--color-gold)] uppercase mb-5"
        >
          Services
        </h3>
        <ul class="space-y-3" role="list">
          {
            serviceLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-[var(--color-muted)] hover:text-[var(--color-gold)] transition-all hover:translate-x-1"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Portfolio -->
      <div>
        <h3
          class="font-mono text-[0.65rem] font-semibold tracking-[0.14em] text-[var(--color-gold)] uppercase mb-5"
        >
          Portfolio
        </h3>
        <ul class="space-y-3" role="list">
          {
            portfolioLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-[var(--color-muted)] hover:text-[var(--color-gold)] transition-all hover:translate-x-1"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3
          class="font-mono text-[0.65rem] font-semibold tracking-[0.14em] text-[var(--color-gold)] uppercase mb-5"
        >
          Get in Touch
        </h3>
        <ul class="space-y-3.5" role="list">
          <li>
            <a
              href="tel:+14046407734"
              class="flex items-center gap-2.5 text-sm text-[var(--color-muted)] hover:text-[var(--color-gold)] transition-all hover:translate-x-1"
            >
              <svg
                class="w-3.5 h-3.5 shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                ></path>
              </svg>
              (404) 640-7734
            </a>
          </li>
          <li>
            <a
              href="mailto:Mr.Jwswain@gmail.com"
              class="flex items-center gap-2.5 text-sm text-[var(--color-muted)] hover:text-[var(--color-gold)] transition-all hover:translate-x-1"
            >
              <svg
                class="w-3.5 h-3.5 shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
              Mr.Jwswain@gmail.com
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/mrjwswain/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2.5 text-sm text-[var(--color-muted)] hover:text-[var(--color-gold)] transition-all hover:translate-x-1"
            >
              <svg
                class="w-3.5 h-3.5 shrink-0"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                ></path>
              </svg>
              LinkedIn
            </a>
          </li>
        </ul>

        <a href="/contact" class="btn-primary mt-6 text-xs px-4 py-2.5 w-full justify-center">
          Contact
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="divider-gold mb-8"></div>
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-[var(--color-muted)]">&copy; {year} Mr. Swain. All rights reserved.</p>
      <p class="text-xs text-[var(--color-muted)] text-center">
        Built with AI automation, clean code &amp; production-grade engineering.
      </p>
      <div class="flex gap-5 text-xs text-[var(--color-muted)]">
        <a href="/privacy" class="hover:text-[var(--color-gold)] transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-[var(--color-gold)] transition-colors">Terms</a>
        <a href="/sitemap.xml" class="hover:text-[var(--color-gold)] transition-colors">Sitemap</a>
        <a href="/resume" class="hover:text-[var(--color-gold)] transition-colors">Resume</a>
      </div>
    </div>
  </div>
</footer>
