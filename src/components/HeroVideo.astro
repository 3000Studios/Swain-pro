---
interface Props {
  src: string;
  opacity?: number;
}
const { src, opacity = 0.45 } = Astro.props;
---
<!-- Absolute video + gradient overlays — parent section must be `relative overflow-hidden` -->
<div class="absolute inset-0" aria-hidden="true">
  <video
    autoplay
    muted
    loop
    playsinline
    aria-hidden="true"
    style={`position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;object-position:center;opacity:${opacity};pointer-events:none;`}
  >
    <source src={src} type="video/mp4" />
  </video>
  <!-- Left-to-right fade so left-aligned text reads cleanly -->
  <div class="absolute inset-0 bg-gradient-to-r from-[#0B0B0B] via-[rgba(11,11,11,0.75)] to-[rgba(11,11,11,0.2)] pointer-events-none"></div>
  <!-- Top + bottom fade for section transitions -->
  <div class="absolute inset-0 bg-gradient-to-b from-[rgba(11,11,11,0.55)] via-transparent to-[#0B0B0B] pointer-events-none"></div>
</div>
