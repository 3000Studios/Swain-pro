---
interface Props {
  src: string;
}
const { src } = Astro.props;
---
<video
  autoplay
  muted
  loop
  playsinline
  aria-hidden="true"
  style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;object-position:center;opacity:0.35;z-index:0;pointer-events:none;"
>
  <source src={src} type="video/mp4" />
</video>
