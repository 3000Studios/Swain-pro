---
const navLinks = [
  { href: '/',             label: 'Home' },
  { href: '/about',        label: 'About' },
  { href: '/projects',     label: 'Projects' },
  { href: '/case-studies', label: 'Case Studies' },
  { href: '/services',     label: 'Services' },
  { href: '/domains',      label: 'Domains' },
  { href: '/resume',       label: 'Resume' },
  { href: '/blog',         label: 'Blog' },
  { href: '/contact',      label: 'Contact' },
]
---

<!-- Fixed header -->
<header class="header-blur fixed top-0 left-0 right-0 z-50" role="banner">
  <nav
    class="max-w-7xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between"
    aria-label="Main navigation"
  >
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center gap-3 group focus-visible:outline-none rounded-lg"
      aria-label="Mr. Swain — Home"
    >
      <div class="relative">
        <img
          src="/images/jeremy-swain.png"
          alt="Jeremy Swain"
          class="w-9 h-9 rounded-full object-cover object-top transition-transform duration-300 group-hover:scale-105 select-none ring-1 ring-[var(--color-gold)] ring-opacity-40"
        />
        <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-[var(--color-emerald)] border-2 border-[var(--color-onyx)]" aria-hidden="true"></span>
      </div>
      <div class="hidden sm:block">
        <span class="block font-display font-semibold text-[var(--color-text)] text-sm tracking-tight leading-none">Mr. Swain</span>
        <span class="block font-mono text-[0.6rem] text-[var(--color-gold)] tracking-widest uppercase leading-none mt-0.5">AI Developer</span>
      </div>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden lg:flex items-center gap-0.5" role="list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            data-nav-link
            class="relative px-3 py-2 rounded-lg text-[0.8125rem] font-medium text-[var(--color-muted)] hover:text-[var(--color-text)] transition-colors duration-200 [&.active]:text-[var(--color-gold)] group"
          >
            {link.label}
            <span class="absolute bottom-1 left-3 right-3 h-px bg-[var(--color-gold)] scale-x-0 group-hover:scale-x-100 [.active_&]:scale-x-100 transition-transform duration-300 origin-left"></span>
          </a>
        </li>
      ))}
    </ul>

    <!-- Right side -->
    <div class="flex items-center gap-3">
      <a
        href="/contact"
        class="btn-primary text-[0.75rem] px-4 py-2 hidden sm:inline-flex"
      >
        Hire Me
      </a>

      <!-- Hamburger button -->
      <button
        id="nav-toggle"
        class="lg:hidden relative z-[210] p-2 rounded-lg text-[var(--color-text)] hover:bg-white/5 transition-colors"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="hamburger flex flex-col gap-[7px]" id="hamburger-icon" aria-hidden="true">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </span>
      </button>
    </div>
  </nav>
</header>

<!-- Header spacer -->
<div class="h-16" aria-hidden="true"></div>

<!-- ── Full-screen mobile nav overlay ── -->
<div
  id="mobile-nav"
  class="mobile-nav-overlay lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
>
  <div class="relative z-10 flex flex-col h-full px-8 sm:px-12 pt-24 pb-10 overflow-y-auto">

    <!-- Large decorative "JS" watermark -->
    <span
      class="absolute top-8 right-6 font-display font-black text-[22vw] text-white/[0.025] leading-none pointer-events-none select-none"
      aria-hidden="true"
    >JS</span>

    <!-- Nav links -->
    <nav aria-label="Mobile navigation">
      <ul class="space-y-1" role="list">
        {navLinks.map((link) => (
          <li class="mobile-nav-item">
            <a
              href={link.href}
              data-nav-link
              class="group flex items-center justify-between py-4 border-b border-white/[0.06] text-[var(--color-dim)] hover:text-[var(--color-ivory)] [&.active]:text-[var(--color-gold)] transition-colors duration-200"
            >
              <span class="font-display font-semibold text-2xl sm:text-3xl tracking-tight">{link.label}</span>
              <svg class="w-5 h-5 opacity-0 group-hover:opacity-100 [.active_&]:opacity-100 transition-all duration-200 group-hover:translate-x-1 text-[var(--color-gold)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Footer strip -->
    <div class="mobile-nav-footer-item mt-auto pt-8 border-t border-white/[0.06]">
      <div class="flex flex-col sm:flex-row gap-4 sm:items-center justify-between">
        <div>
          <p class="font-mono text-[0.65rem] text-[var(--color-gold)] tracking-widest uppercase mb-1">Get in touch</p>
          <a href="tel:+14046407734" class="text-[var(--color-dim)] hover:text-[var(--color-ivory)] text-sm transition-colors">(404) 640-7734</a>
        </div>
        <div class="flex gap-4">
          <a href="https://www.linkedin.com/in/mrjwswain/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-muted)] hover:text-[var(--color-gold)] transition-colors" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="https://github.com/3000Studios" target="_blank" rel="noopener noreferrer" class="text-[var(--color-muted)] hover:text-[var(--color-gold)] transition-colors" aria-label="GitHub">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Backdrop -->
<div
  id="nav-backdrop"
  class="fixed inset-0 z-[190] bg-black/50 opacity-0 pointer-events-none transition-opacity duration-500 lg:hidden"
  aria-hidden="true"
></div>

<script>
  const toggle   = document.getElementById('nav-toggle')!
  const nav      = document.getElementById('mobile-nav')!
  const backdrop = document.getElementById('nav-backdrop')!
  const hamburger = document.getElementById('hamburger-icon')!

  function openNav() {
    nav.classList.add('is-open')
    backdrop.classList.remove('opacity-0', 'pointer-events-none')
    hamburger.classList.add('is-open')
    toggle.setAttribute('aria-expanded', 'true')
    document.body.style.overflow = 'hidden'
  }

  function closeNav() {
    nav.classList.remove('is-open')
    backdrop.classList.add('opacity-0', 'pointer-events-none')
    hamburger.classList.remove('is-open')
    toggle.setAttribute('aria-expanded', 'false')
    document.body.style.overflow = ''
  }

  toggle.addEventListener('click', () => {
    nav.classList.contains('is-open') ? closeNav() : openNav()
  })

  backdrop.addEventListener('click', closeNav)

  nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeNav))

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeNav()
  })
</script>
