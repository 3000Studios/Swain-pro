---
import BaseLayout from '../layouts/BaseLayout.astro'
import ProjectExplorer from '../components/ProjectExplorer.tsx'
import { projects } from '../data/projects'
---

<BaseLayout
  title="Projects — Jeremy Swain AI Developer"
  description="Real AI projects, automation tools, and full-stack systems built by Jeremy Swain. VoiceToWebsite, MyAppAI, PlayStoreWizard, YouTuneAI, and more."
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-20">
    <div class="max-w-2xl mb-16">
      <p class="section-label">Portfolio</p>
      <h1 class="text-4xl sm:text-5xl font-black mb-5">
        Real <span class="gradient-text">Projects</span>
      </h1>
      <p class="text-[var(--color-dim)] text-lg leading-relaxed">
        AI systems, automation tools, and full-stack applications built, deployed, and running.
        Filter by category, expand any card for full details.
      </p>
    </div>

    <ProjectExplorer projects={projects} client:load />
  </section>
</BaseLayout>
