---
import BaseLayout from '../layouts/BaseLayout.astro'
import GalaxyBg from '../components/backgrounds/GalaxyBg'
import NeuralNetBg from '../components/backgrounds/NeuralNetBg'
import ProjectExplorer from '../components/ProjectExplorer.tsx'
import HeroVideo from '../components/HeroVideo.astro'
import { projects } from '../data/projects'
---

<BaseLayout
  title="Projects — Mr. Swain AI Developer"
  description="Real AI projects, automation tools, and full-stack systems built by Mr. Swain. VoiceToWebsite, MyAppAI, PlayStoreWizard, YouTuneAI, and more."
>

  <!-- Hero (dark) -->
  <section class="section-dark relative overflow-hidden min-h-[80vh] flex items-center">
    <HeroVideo src="/videos/hero-projects.mp4" />
    <GalaxyBg client:only="react" />
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 py-24 lg:py-32">
      <div class="max-w-2xl">
        <p class="section-label">Portfolio</p>
        <h1 class="text-5xl sm:text-6xl font-black mb-6 text-[var(--color-text)]">
          Real <span class="gradient-text">Projects</span>
        </h1>
        <p class="text-[var(--color-dim)] text-xl leading-relaxed">
          AI systems, automation tools, and full-stack applications built, deployed, and running.
          Filter by category, expand any card for full details.
        </p>
      </div>
    </div>
  </section>

  <!-- Explorer (dark) -->
  <section class="section-dark relative overflow-hidden">
    <NeuralNetBg client:only="react" />
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 py-24">
      <ProjectExplorer projects={projects} client:load />
    </div>
  </section>

</BaseLayout>
