---
import BaseLayout from '../layouts/BaseLayout.astro'

const services = [
  {
    id: 'ai-development',
    icon: '🧠',
    title: 'AI Development',
    subtitle: 'End-to-end LLM systems that actually work in production',
    description: 'Full lifecycle AI development: requirements gathering, system architecture, model integration, validation, deployment, and monitoring. GPT-4, Claude, Gemini, and open-source models. Multi-agent systems, RAG pipelines, and custom fine-tuning where appropriate.',
    deliverables: ['LLM integration architecture', 'Multi-agent workflow systems', 'RAG/retrieval pipelines', 'Production deployment with monitoring', 'Accuracy validation and testing'],
    ideal: 'Businesses needing a reliable AI system built from scratch or an existing workflow that needs an intelligent layer added.',
  },
  {
    id: 'automation',
    icon: '⚙️',
    title: 'Automation Engineering',
    subtitle: 'Python pipelines that eliminate manual, repetitive work',
    description: "Workflow automation using Python, LangChain, REST APIs, and integration platforms. Document processing, data extraction, CRM automation, reporting pipelines, scheduled jobs, and event-driven automation. If your team is doing the same thing manually more than 10 times per week, it's automatable.",
    deliverables: ['Document/email processing pipelines', 'Automated reporting workflows', 'API integration and data sync', 'Scheduled automation scripts', 'Exception handling and monitoring'],
    ideal: 'Operations teams spending hours on repetitive data entry, report generation, document processing, or system synchronization.',
  },
  {
    id: 'llm-integration',
    icon: '🔗',
    title: 'LLM Integration',
    subtitle: 'Connecting language models to your existing systems',
    description: 'Integrate GPT-4, Claude, Gemini, and other LLMs into your existing applications, workflows, and platforms. Custom knowledge bases, prompt optimization, API wrappers, streaming interfaces, and cost management. Works with any tech stack — Python, Node.js, TypeScript, REST APIs.',
    deliverables: ['LLM API integration and abstraction', 'Custom knowledge base construction', 'Prompt engineering and optimization', 'Cost monitoring and rate limiting', 'Multi-provider routing for reliability'],
    ideal: 'Product teams wanting to add AI capabilities to existing tools, or developers needing an experienced hand on LLM plumbing.',
  },
  {
    id: 'consulting',
    icon: '💡',
    title: 'AI Strategy & Consulting',
    subtitle: 'Practical AI roadmaps for businesses ready to act',
    description: "Not strategy decks that collect dust — practical AI roadmaps you can actually execute. Process analysis to identify automation candidates, ROI modeling, vendor evaluation, build vs. buy decisions, and a clear prioritized implementation plan. Delivered with the perspective of someone who's built these systems, not just advised on them.",
    deliverables: ['Workflow automation audit', 'AI opportunity prioritization', 'ROI modeling per use case', 'Vendor/tool evaluation', 'Implementation roadmap'],
    ideal: 'Business leaders who know AI automation is relevant but need help identifying where to start and whether to build or buy.',
  },
  {
    id: 'business-analysis',
    icon: '📊',
    title: 'Business Analysis',
    subtitle: 'Requirements and delivery management for technical projects',
    description: 'Technical business analysis for AI and automation projects. Requirements gathering, user stories, gap analysis, process documentation, Agile/Scrum facilitation, and stakeholder alignment. Bridging the gap between what the business needs and what the development team builds.',
    deliverables: ['Requirements documentation', 'User stories and acceptance criteria', 'Process flow diagrams', 'Gap analysis reports', 'Stakeholder communication plans'],
    ideal: 'Technical teams needing BA support, or business teams that need someone technical enough to translate requirements into implementation specs.',
  },
  {
    id: 'fullstack',
    icon: '🚀',
    title: 'Full-Stack AI Applications',
    subtitle: 'Complete AI-powered web applications deployed on Cloudflare',
    description: 'End-to-end build of AI-powered web applications: React/TypeScript frontend, Python or Node.js backend, LLM integration, database, and Cloudflare deployment. From voice-activated tools to intelligent dashboards to automated content platforms.',
    deliverables: ['React/TypeScript frontend', 'API backend with LLM integration', 'Database design and implementation', 'Cloudflare Workers/Pages deployment', 'Production monitoring and analytics'],
    ideal: 'Founders and product teams who need an AI-powered application built and shipped — not a prototype, a real product.',
  },
]
---

<BaseLayout
  title="Services — Jeremy Swain AI Developer & Automation Engineer"
  description="AI development, automation engineering, LLM integration, and business analysis services by Jeremy Swain. Based in Atlanta, GA. Available for contracts, consulting, and full project builds."
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-20">
    <div class="max-w-2xl mb-16">
      <p class="section-label">What I Do</p>
      <h1 class="text-4xl sm:text-5xl font-black mb-5">
        AI & Automation<br /><span class="gradient-text">Services</span>
      </h1>
      <p class="text-[var(--color-dim)] text-lg leading-relaxed">
        End-to-end AI development, workflow automation, LLM integration, and business analysis.
        Available for project contracts, consulting engagements, and full-time roles.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 mb-20">
      {services.map(service => (
        <article class="reveal card p-7 flex flex-col" id={service.id}>
          <div class="text-3xl mb-4" aria-hidden="true">{service.icon}</div>
          <h2 class="font-black text-[var(--color-text)] text-xl mb-2">{service.title}</h2>
          <p class="text-[var(--color-cyan)] text-sm font-medium mb-4">{service.subtitle}</p>
          <p class="text-sm text-[var(--color-dim)] leading-relaxed mb-6 flex-1">{service.description}</p>

          <div class="mb-6">
            <p class="text-xs font-semibold text-[var(--color-muted)] uppercase tracking-wider mb-2">Deliverables</p>
            <ul class="space-y-1.5">
              {service.deliverables.map(d => (
                <li class="flex items-start gap-2 text-xs text-[var(--color-dim)]">
                  <span class="text-[var(--color-cyan)] shrink-0">▸</span>
                  {d}
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-5 border-t border-[var(--color-border)]">
            <p class="text-xs text-[var(--color-muted)] mb-1 font-semibold">Ideal for:</p>
            <p class="text-xs text-[var(--color-dim)] italic">{service.ideal}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- Engagement models -->
    <div class="reveal mb-16">
      <p class="section-label">How We Work</p>
      <h2 class="text-3xl font-black mb-8">Engagement <span class="gradient-text">Models</span></h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {[
          { title: 'Project Contract', icon: '📋', desc: 'Scoped deliverables, defined timeline, fixed or milestone-based pricing. Best for well-defined builds.' },
          { title: 'Consulting Retainer', icon: '🤝', desc: 'Ongoing advisory, review, and implementation support. Best for teams that need an AI expert on call.' },
          { title: 'Full-Time Role', icon: '💼', desc: 'Open to FTE opportunities as AI Developer, Automation Engineer, or Technical Business Analyst.' },
        ].map(model => (
          <div class="card p-6">
            <div class="text-2xl mb-3" aria-hidden="true">{model.icon}</div>
            <h3 class="font-semibold text-[var(--color-text)] mb-2">{model.title}</h3>
            <p class="text-sm text-[var(--color-muted)] leading-relaxed">{model.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="reveal card p-10 text-center border-[var(--color-border-glow)]">
      <h2 class="text-3xl font-black mb-4">
        Ready to Get Started?
      </h2>
      <p class="text-[var(--color-dim)] max-w-lg mx-auto mb-8">
        Describe your project or challenge. I'll tell you honestly if I can help and what a realistic solution looks like.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/contact" class="btn-primary px-8">Start a Conversation</a>
        <a href="tel:+14046407734" class="btn-outline px-8">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          Call (404) 640-7734
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
