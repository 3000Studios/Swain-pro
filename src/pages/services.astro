---
import BaseLayout from '../layouts/BaseLayout.astro'
import MagneticBg from '../components/backgrounds/MagneticBg'
import NeuralNetBg from '../components/backgrounds/NeuralNetBg'
import WaveGridBg from '../components/backgrounds/WaveGridBg'
import HeroVideo from '../components/HeroVideo.astro'

const services = [
  {
    id: 'ai-development',
    title: 'AI Development',
    subtitle: 'End-to-end LLM systems that actually work in production',
    description: 'Full lifecycle AI development: requirements gathering, system architecture, model integration, validation, deployment, and monitoring. GPT-4, Claude, Gemini, and open-source models. Multi-agent systems, RAG pipelines, and custom fine-tuning where appropriate.',
    deliverables: ['LLM integration architecture', 'Multi-agent workflow systems', 'RAG/retrieval pipelines', 'Production deployment with monitoring', 'Accuracy validation and testing'],
    ideal: 'Businesses needing a reliable AI system built from scratch or an existing workflow that needs an intelligent layer added.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1 1 .03 2.7-1.41 2.7H4.21c-1.44 0-2.41-1.7-1.41-2.7L4.2 15.3"/>`,
  },
  {
    id: 'automation',
    title: 'Automation Engineering',
    subtitle: 'Python pipelines that eliminate manual, repetitive work',
    description: "Workflow automation using Python, LangChain, REST APIs, and integration platforms. Document processing, data extraction, CRM automation, reporting pipelines, scheduled jobs, and event-driven automation. If your team is doing the same thing manually more than 10 times per week, it's automatable.",
    deliverables: ['Document/email processing pipelines', 'Automated reporting workflows', 'API integration and data sync', 'Scheduled automation scripts', 'Exception handling and monitoring'],
    ideal: 'Operations teams spending hours on repetitive data entry, report generation, document processing, or system synchronization.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12a7.5 7.5 0 0015 0m-15 0a7.5 7.5 0 1115 0m-15 0H3m16.5 0H21m-1.5 0H12m-8.457 3.077l1.41-.513m14.095-5.13l1.41-.513M5.106 17.785l1.15-.964m11.49-9.642l1.149-.964M7.501 19.795l.75-1.3m7.5-12.99l.75-1.3m-6.063 16.658l.26-1.477m2.605-14.772l.26-1.477m0 17.726l-.26-1.477M10.698 4.614l-.26-1.477M16.5 19.794l-.75-1.299M7.5 4.205L12 12m6.894 5.785l-1.149-.964M6.256 7.178l-1.15-.964m15.352 8.864l-1.41-.513M4.954 9.435l-1.41-.514M12.002 12l-3.75 6.495"/>`,
  },
  {
    id: 'llm-integration',
    title: 'LLM Integration',
    subtitle: 'Connecting language models to your existing systems',
    description: 'Integrate GPT-4, Claude, Gemini, and other LLMs into your existing applications, workflows, and platforms. Custom knowledge bases, prompt optimization, API wrappers, streaming interfaces, and cost management. Works with any tech stack.',
    deliverables: ['LLM API integration and abstraction', 'Custom knowledge base construction', 'Prompt engineering and optimization', 'Cost monitoring and rate limiting', 'Multi-provider routing for reliability'],
    ideal: 'Product teams wanting to add AI capabilities to existing tools, or developers needing an experienced hand on LLM plumbing.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"/>`,
  },
  {
    id: 'consulting',
    title: 'AI Strategy & Consulting',
    subtitle: 'Practical AI roadmaps for businesses ready to act',
    description: "Not strategy decks that collect dust — practical AI roadmaps you can actually execute. Process analysis to identify automation candidates, ROI modeling, vendor evaluation, build vs. buy decisions, and a clear prioritized implementation plan.",
    deliverables: ['Workflow automation audit', 'AI opportunity prioritization', 'ROI modeling per use case', 'Vendor/tool evaluation', 'Implementation roadmap'],
    ideal: 'Business leaders who know AI automation is relevant but need help identifying where to start and whether to build or buy.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18"/>`,
  },
  {
    id: 'business-analysis',
    title: 'Business Analysis',
    subtitle: 'Requirements and delivery management for technical projects',
    description: 'Technical business analysis for AI and automation projects. Requirements gathering, user stories, gap analysis, process documentation, Agile/Scrum facilitation, and stakeholder alignment.',
    deliverables: ['Requirements documentation', 'User stories and acceptance criteria', 'Process flow diagrams', 'Gap analysis reports', 'Stakeholder communication plans'],
    ideal: 'Technical teams needing BA support, or business teams that need someone technical enough to translate requirements into implementation specs.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>`,
  },
  {
    id: 'fullstack',
    title: 'Full-Stack AI Applications',
    subtitle: 'Complete AI-powered web apps deployed on Cloudflare',
    description: 'End-to-end build of AI-powered web applications: React/TypeScript frontend, Python or Node.js backend, LLM integration, database, and Cloudflare deployment. From voice-activated tools to intelligent dashboards to automated content platforms.',
    deliverables: ['React/TypeScript frontend', 'API backend with LLM integration', 'Database design and implementation', 'Cloudflare Workers/Pages deployment', 'Production monitoring and analytics'],
    ideal: 'Founders and product teams who need an AI-powered application built and shipped — not a prototype, a real product.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0l4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0l-5.571 3-5.571-3"/>`,
  },
]
---

<BaseLayout
  title="Services — Mr. Swain AI Developer & Automation Engineer"
  description="AI development, automation engineering, LLM integration, and business analysis services by Mr. Swain. Available for contracts, consulting, and full project builds."
>

  <!-- Hero (dark) -->
  <section class="section-dark relative overflow-hidden min-h-[80vh] flex items-center">
    <HeroVideo src="/videos/hero-services.mp4" />
    <WaveGridBg client:only="react" />
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 py-24 lg:py-32">
      <div class="max-w-2xl">
        <p class="section-label">What I Do</p>
        <h1 class="text-5xl sm:text-6xl font-black mb-6 text-[var(--color-text)]">
          AI & Automation<br /><span class="gradient-text">Services</span>
        </h1>
        <p class="text-[var(--color-dim)] text-xl leading-relaxed">
          End-to-end AI development, workflow automation, LLM integration, and business analysis.
          Available for project contracts, consulting engagements, and full-time roles.
        </p>
      </div>
    </div>
  </section>

  <!-- Service cards (light) -->
  <section class="section-light relative overflow-hidden">
    <NeuralNetBg client:only="react" light />
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 py-28">
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 mb-24" data-stagger-parent>
        {services.map((service, i) => (
          <article
            class="reveal-scale card-light rounded-[var(--radius-card)] p-7 flex flex-col"
            style={`--delay:${i * 80}ms`}
            id={service.id}
            data-stagger
          >
            <div class="w-12 h-12 rounded-xl bg-[var(--color-onyx)] text-[var(--color-gold)] flex items-center justify-center mb-5" set:html={service.icon}></div>
            <h2 class="font-black text-[var(--color-onyx)] text-xl mb-2">{service.title}</h2>
            <p class="text-[var(--color-gold-dark)] text-sm font-semibold mb-4">{service.subtitle}</p>
            <p class="text-sm text-[var(--color-onyx)]/60 leading-relaxed mb-6 flex-1">{service.description}</p>

            <div class="mb-6">
              <p class="text-[0.65rem] font-mono font-semibold text-[var(--color-onyx)]/40 uppercase tracking-[0.12em] mb-3">Deliverables</p>
              <ul class="space-y-2">
                {service.deliverables.map(d => (
                  <li class="flex items-start gap-2 text-xs text-[var(--color-onyx)]/65">
                    <span class="text-[var(--color-gold-dark)] shrink-0 mt-0.5">▸</span>
                    {d}
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-5 border-t border-[var(--color-border-light)]">
              <p class="text-[0.65rem] font-mono font-semibold text-[var(--color-onyx)]/40 uppercase tracking-[0.12em] mb-1.5">Ideal for</p>
              <p class="text-xs text-[var(--color-onyx)]/55 italic">{service.ideal}</p>
            </div>
          </article>
        ))}
      </div>

      <!-- Engagement models -->
      <div class="reveal-up mb-6">
        <p class="section-label">How We Work</p>
        <h2 class="text-3xl font-black mb-10 text-[var(--color-onyx)]">Engagement <span class="gradient-text">Models</span></h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5" data-stagger-parent>
          {[
            {
              title: 'Project Contract',
              desc: 'Scoped deliverables, defined timeline, fixed or milestone-based pricing. Best for well-defined builds.',
              icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"/>`,
            },
            {
              title: 'Consulting Retainer',
              desc: 'Ongoing advisory, review, and implementation support. Best for teams that need an AI expert on call.',
              icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>`,
            },
            {
              title: 'Full-Time Role',
              desc: 'Open to FTE opportunities as AI Developer, Automation Engineer, or Technical Business Analyst.',
              icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z"/>`,
            },
          ].map((model, i) => (
            <div class="reveal-scale card-light p-6 rounded-[var(--radius-card)]" style={`--delay:${i*100}ms`} data-stagger>
              <div class="w-10 h-10 rounded-lg bg-[var(--color-onyx)] text-[var(--color-gold)] flex items-center justify-center mb-4" set:html={model.icon}></div>
              <h3 class="font-semibold text-[var(--color-onyx)] mb-2">{model.title}</h3>
              <p class="text-sm text-[var(--color-onyx)]/55 leading-relaxed">{model.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA (dark) -->
  <section class="section-dark relative overflow-hidden">
    <MagneticBg client:only="react" />
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 py-24">
      <div class="reveal-up card p-10 sm:p-14 text-center border-glow max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-black mb-5 text-[var(--color-text)]">Ready to Get Started?</h2>
        <p class="text-[var(--color-dim)] max-w-lg mx-auto mb-10 text-lg leading-relaxed">
          Describe your project or challenge. I'll tell you honestly if I can help and what a realistic solution looks like.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="/contact" class="btn-primary px-8">Start a Conversation</a>
          <a href="tel:+14046407734" class="btn-outline px-8">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            Call (404) 640-7734
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
