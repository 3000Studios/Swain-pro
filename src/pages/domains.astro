---
import BaseLayout from '../layouts/BaseLayout.astro'
import HexGridBg from '../components/backgrounds/HexGridBg'
import LavaBg from '../components/backgrounds/LavaBg'
import HeroVideo from '../components/HeroVideo.astro'
import FleetGrid from '../components/FleetGrid.astro'
import { domains, FLEET_CAPTURED } from '../data/domains'

const groupsTotal = new Set(domains.map((d) => d.category)).size
---

<BaseLayout
  title="Domains & Ventures — Mr. Swain"
  description="Active domains and digital ventures built and owned by Mr. Swain — VoiceToWebsite, PlayStoreWizard, FindMeRates, GetNexa, 3000Studios, and more."
>

  <!-- Hero (dark) -->
  <section class="section-dark relative overflow-hidden min-h-[80vh] flex items-center">
    <HeroVideo src="/videos/hero-domains.mp4" />
    <HexGridBg client:only="react" />
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 py-24 lg:py-32">
      <div class="max-w-2xl">
        <p class="section-label">Ventures</p>
        <h1 class="text-5xl sm:text-6xl font-black mb-6 text-[var(--color-text)]">
          Domains &amp;<br /><span class="gradient-text">Ventures</span>
        </h1>
        <p class="text-[var(--color-dim)] text-xl leading-relaxed">
          {domains.length} live properties, products and ventures built and operated by Mr. Swain,
          plus Aeropocalypse: Online on Google Play. Every site was opened and re-shot on {FLEET_CAPTURED}.
        </p>
      </div>
    </div>
  </section>

  <!-- Fleet grid (dark, animated cards) -->
  <section class="fleet-section section-dark relative overflow-hidden" aria-labelledby="fleet-title">
    <div class="fleet-section__bg" aria-hidden="true"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 py-24 sm:py-28">
      <div class="reveal-up mb-10">
        <p class="section-label">The Fleet</p>
        <h2 id="fleet-title" class="text-4xl sm:text-5xl font-black text-[var(--color-text)]">
          Every <span class="gradient-text-animated">Live Site</span>
        </h2>
      </div>

      <FleetGrid sites={domains} capturedLabel={FLEET_CAPTURED} id="domains-fleet" />

      <!-- Stats -->
      <div class="reveal-up mt-16">
        <div class="fleet-stats rounded-[var(--radius-card)] p-8 sm:p-10">
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 text-center">
            {[
              { value: String(domains.length), label: 'Live Sites' },
              { value: String(groupsTotal), label: 'Categories' },
              { value: '1', label: 'Game on Google Play' },
              { value: '2025–26', label: 'Fleet Built' },
            ].map((stat) => (
              <div>
                <div class="text-3xl sm:text-4xl font-black gradient-text-animated mb-2 tabular-nums">{stat.value}</div>
                <div class="text-xs text-[var(--color-muted)] font-mono uppercase tracking-widest">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA (dark) -->
  <section class="section-dark relative overflow-hidden">
    <LavaBg client:only="react" />
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 py-24">
      <div class="reveal-up max-w-xl">
        <h2 class="text-3xl font-black mb-5 text-[var(--color-text)]">Interested in a venture?</h2>
        <p class="text-[var(--color-dim)] mb-10 text-lg leading-relaxed">
          Exploring licensing, partnerships, or white-label opportunities on any of these properties? Let's talk.
        </p>
        <a href="/contact" class="btn-primary">Get in Touch</a>
      </div>
    </div>
  </section>

</BaseLayout>
