---
import BaseLayout from '../layouts/BaseLayout.astro'
import { skillCategories, coreCompetencies } from '../data/skills'
---

<BaseLayout
  title="About Jeremy Swain — AI Developer & Automation Engineer"
  description="Jeremy Swain is an AI Developer, Automation Engineer, and LLM Integration Specialist based in Atlanta, GA. Former Capgemini business analyst, now building AI systems for modern businesses."
>
  <!-- Hero -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-20 lg:py-28">
    <div class="max-w-3xl">
      <p class="section-label">About</p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black mb-6 leading-tight">
        Builds AI That Ships.<br />
        <span class="gradient-text">Not Just Demos.</span>
      </h1>
      <p class="text-xl text-[var(--color-dim)] leading-relaxed">
        Jeremy Swain is an AI Developer, Automation Engineer, LLM Integration Specialist,
        and Business Analyst based in Atlanta, GA — with 7+ years of experience across enterprise
        consulting, private AI development, and full-stack technical build.
      </p>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-12 border-t border-[var(--color-border)]">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <div class="reveal">
        <p class="section-label">Philosophy</p>
        <h2 class="text-2xl sm:text-3xl font-black mb-6">
          End-to-End or<br /><span class="gradient-text">Nothing</span>
        </h2>
        <div class="space-y-4 text-[var(--color-dim)] leading-relaxed">
          <p>
            Most AI projects fail not because the models aren't good enough — they fail because
            the gap between prototype and production never gets closed. Requirements are vague.
            Data quality is ignored. Accuracy thresholds are never defined. Monitoring never
            gets built. Nobody owns the edge cases.
          </p>
          <p>
            I don't build prototypes that live in notebooks. Every system I design is built
            for the real world: clear requirements, validated against real data, deployed to
            infrastructure that runs, monitored for drift, and documented so it can be maintained.
          </p>
          <p>
            That combination — technical depth plus business context — is what separates an
            AI system that genuinely reduces cost and improves operations from one that
            demonstrates nicely and then gets abandoned.
          </p>
        </div>
      </div>

      <div class="reveal space-y-4">
        {[
          { label: 'AI Development', value: 95, color: 'var(--color-cyan)' },
          { label: 'Python / LangChain', value: 90, color: 'var(--color-purple)' },
          { label: 'Business Analysis', value: 95, color: 'var(--color-emerald)' },
          { label: 'Cloudflare Deployment', value: 90, color: 'var(--color-amber)' },
          { label: 'LLM Prompt Engineering', value: 95, color: 'var(--color-cyan)' },
          { label: 'TypeScript / React', value: 85, color: 'var(--color-purple)' },
        ].map(item => (
          <div>
            <div class="flex justify-between mb-2">
              <span class="text-sm font-medium text-[var(--color-text)]">{item.label}</span>
              <span class="text-sm font-mono text-[var(--color-muted)]">{item.value}%</span>
            </div>
            <div class="skill-bar-track">
              <div
                class="skill-bar-fill"
                style={`width: ${item.value}%; background: linear-gradient(90deg, ${item.color}, var(--color-purple))`}
              ></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-24 border-t border-[var(--color-border)]">
    <div class="reveal mb-12">
      <p class="section-label">Experience</p>
      <h2 class="text-3xl sm:text-4xl font-black">
        Professional <span class="gradient-text">History</span>
      </h2>
    </div>

    <div class="space-y-0 relative before:absolute before:left-4 sm:before:left-6 before:top-2 before:bottom-2 before:w-px before:bg-[var(--color-border)]">
      {[
        {
          role: 'Webmaster & AI Developer',
          company: 'Empire Tours & Productions',
          location: 'Atlanta, GA',
          period: 'Feb 2025 – Jul 2025',
          color: 'cyan',
          highlights: [
            'Revamped digital infrastructure with AI-powered content personalization and chatbot automation.',
            'Designed and deployed a GPT-based virtual assistant handling customer inquiries and scheduling.',
            'Automated backend workflows for SEO, analytics, bookings, and content updates.',
            'Built real-time dashboards surfacing marketing and engagement insights.',
            'Improved reporting speed and operational visibility across the business.',
          ],
        },
        {
          role: 'AI Developer / Business Analyst',
          company: 'Private Client',
          location: 'Atlanta, GA',
          period: 'Aug 2022 – Dec 2023',
          color: 'purple',
          highlights: [
            'Designed and implemented end-to-end AI automations using GPT and LangChain-style workflows.',
            'Built AI agents for document parsing, lead management, and CRM workflow automation.',
            'Integrated Python tools with Salesforce pipelines, analytics, and customer reporting.',
            'Delivered AI strategy recommendations aligned with measurable business outcomes.',
            'Improved team productivity and reduced repetitive processing through automation.',
          ],
        },
        {
          role: 'Business Analyst',
          company: 'Capgemini',
          location: 'Atlanta, GA',
          period: 'Apr 2019 – Jul 2022',
          color: 'emerald',
          highlights: [
            'Supported enterprise digital transformation involving CRM, automation, dashboards, and process modernization.',
            'Gathered requirements, created user stories, conducted gap analyses, and supported Agile delivery.',
            'Used Jira, Azure DevOps, Salesforce, Power BI, and process documentation in daily work.',
            'Aligned stakeholders across global teams in security-conscious enterprise environments.',
            'Delivered KPI tracking frameworks and dashboard solutions for business intelligence.',
          ],
        },
      ].map(exp => (
        <div class="reveal relative pl-10 sm:pl-14 pb-12">
          <div class={`absolute left-2 sm:left-4 top-1 w-4 h-4 rounded-full border-2 border-[var(--color-${exp.color})] bg-[var(--color-bg)] flex items-center justify-center`}>
            <div class={`w-2 h-2 rounded-full bg-[var(--color-${exp.color})]`}></div>
          </div>
          <div class="card p-6">
            <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
              <div>
                <h3 class="font-bold text-[var(--color-text)] text-lg">{exp.role}</h3>
                <p class="text-[var(--color-dim)] font-medium">{exp.company} — {exp.location}</p>
              </div>
              <span class="badge badge-cyan font-mono">{exp.period}</span>
            </div>
            <ul class="space-y-2">
              {exp.highlights.map(h => (
                <li class="flex items-start gap-2 text-sm text-[var(--color-dim)]">
                  <span class="text-[var(--color-cyan)] mt-0.5 shrink-0">▸</span>
                  {h}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Education -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16 border-t border-[var(--color-border)]">
    <div class="reveal mb-12">
      <p class="section-label">Education</p>
      <h2 class="text-3xl font-black">Academic <span class="gradient-text">Background</span></h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      {[
        { degree: 'Full Stack Web Development Certificate', school: 'Georgia Institute of Technology', icon: '🎓', color: 'cyan' },
        { degree: 'A.A.S., Information Technology', school: 'Chattahoochee Technical College', icon: '💻', color: 'purple' },
        { degree: 'High School Diploma', school: 'East Coweta High School', icon: '📜', color: 'emerald' },
      ].map(edu => (
        <div class="reveal card p-6 flex gap-4 items-start">
          <div class="text-2xl shrink-0" aria-hidden="true">{edu.icon}</div>
          <div>
            <h3 class="font-semibold text-[var(--color-text)] text-sm leading-tight mb-1">{edu.degree}</h3>
            <p class="text-xs text-[var(--color-muted)]">{edu.school}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Skills full grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16 border-t border-[var(--color-border)]">
    <div class="reveal mb-12">
      <p class="section-label">Technical Skills</p>
      <h2 class="text-3xl font-black">Full <span class="gradient-text">Stack</span></h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
      {skillCategories.map(cat => (
        <div class="reveal card p-5">
          <div class="flex items-center gap-2 mb-4">
            <span aria-hidden="true">{cat.icon}</span>
            <h3 class="font-semibold text-sm text-[var(--color-text)]">{cat.label}</h3>
          </div>
          <ul class="space-y-1.5">
            {cat.skills.map(s => (
              <li class="flex items-center gap-2 text-xs text-[var(--color-muted)]">
                <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-cyan)] shrink-0" aria-hidden="true"></span>
                {s.name}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-20 border-t border-[var(--color-border)]">
    <div class="reveal max-w-xl">
      <h2 class="text-3xl font-black mb-4">Ready to work together?</h2>
      <p class="text-[var(--color-dim)] mb-8">
        Whether it's a full AI automation build, a consulting engagement, or a targeted
        workflow fix — I'd like to hear about your project.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/contact" class="btn-primary">Hire Jeremy</a>
        <a href="/resume" class="btn-outline">View Resume</a>
      </div>
    </div>
  </section>
</BaseLayout>
