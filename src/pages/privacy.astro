---
import BaseLayout from '../layouts/BaseLayout.astro'
import HexGridBg from '../components/backgrounds/HexGridBg'
import WaveGridBg from '../components/backgrounds/WaveGridBg'
---

<BaseLayout
  title="Privacy Policy — Mr. Swain | swain.pro"
  description="Privacy policy for swain.pro — how Mr. Swain collects, uses, and protects your information."
>

  <!-- Hero (dark) -->
  <section class="section-dark relative overflow-hidden py-24 lg:py-32">
    <HexGridBg client:only="react" />
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8">
      <div class="max-w-3xl">
        <p class="section-label">Legal</p>
        <h1 class="text-5xl sm:text-6xl font-black mb-6 text-[var(--color-text)]">
          Privacy <span class="gradient-text">Policy</span>
        </h1>
        <p class="text-[var(--color-dim)] text-lg leading-relaxed">
          Last updated: June 9, 2026
        </p>
      </div>
    </div>
  </section>

  <!-- Content (light) -->
  <section class="section-light relative overflow-hidden">
    <WaveGridBg client:only="react" light />
    <div class="relative z-10 max-w-4xl mx-auto px-5 sm:px-8 py-20">
      <div class="prose-policy space-y-12 text-[var(--color-onyx)]/80 leading-relaxed text-[1.05rem]">

        <!-- Introduction -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Introduction</h2>
          <p>
            This Privacy Policy explains how Mr. Swain ("I," "me," or "my") collects, uses, stores, and protects information when you visit <strong>swain.pro</strong> (the "Site"). This Site is a professional portfolio and services website operated by Mr. Swain, an AI Developer &amp; Automation Engineer based in Atlanta, GA.
          </p>
          <p class="mt-4">
            By accessing or using the Site, you agree to the collection and use of information in accordance with this policy. If you do not agree with any part of this policy, please discontinue use of the Site.
          </p>
        </div>

        <!-- Information I Collect -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Information I Collect</h2>

          <h3 class="text-lg font-bold text-[var(--color-onyx)] mt-6 mb-3">Information You Provide Directly</h3>
          <p>
            When you use the contact form on this Site, you voluntarily provide the following information:
          </p>
          <ul class="list-disc pl-6 mt-3 space-y-2">
            <li><strong>Name</strong> — so I can address you properly in my response.</li>
            <li><strong>Email address</strong> — so I can reply to your inquiry.</li>
            <li><strong>Project type</strong> — to understand the nature of your request.</li>
            <li><strong>Message content</strong> — the details of your project or inquiry.</li>
          </ul>
          <p class="mt-4">
            This information is used exclusively to respond to your inquiry and evaluate potential project engagements. I do not sell, rent, or share your contact information with third parties for marketing purposes.
          </p>

          <h3 class="text-lg font-bold text-[var(--color-onyx)] mt-6 mb-3">Information Collected Automatically</h3>
          <p>
            When you visit the Site, certain information is collected automatically through cookies and similar technologies:
          </p>
          <ul class="list-disc pl-6 mt-3 space-y-2">
            <li><strong>Device and browser information</strong> — browser type, operating system, screen resolution, and device type.</li>
            <li><strong>Usage data</strong> — pages visited, time spent on pages, referring URLs, and navigation paths.</li>
            <li><strong>IP address</strong> — used for approximate geographic location and security purposes.</li>
            <li><strong>Language preferences</strong> — based on your browser settings.</li>
          </ul>
        </div>

        <!-- Google Analytics -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Google Analytics</h2>
          <p>
            This Site uses <strong>Google Analytics</strong>, a web analytics service provided by Google LLC, to understand how visitors interact with the Site. Google Analytics uses cookies — small text files placed on your device — to collect standard internet log information and visitor behavior data.
          </p>
          <p class="mt-4">
            The information generated by Google Analytics cookies about your use of this Site is transmitted to and stored by Google on servers in the United States. Google may use this data to:
          </p>
          <ul class="list-disc pl-6 mt-3 space-y-2">
            <li>Track and report on website traffic and usage patterns.</li>
            <li>Provide aggregated demographic and interest reports.</li>
            <li>Support features such as remarketing and audience insights.</li>
          </ul>
          <p class="mt-4">
            Google's use of this data is governed by the <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="text-[var(--color-gold-dark)] underline hover:no-underline">Google Privacy Policy</a>. You can opt out of Google Analytics tracking by installing the <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer" class="text-[var(--color-gold-dark)] underline hover:no-underline">Google Analytics Opt-out Browser Add-on</a>.
          </p>
        </div>

        <!-- Cookies -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Cookies &amp; Tracking Technologies</h2>
          <p>
            This Site uses the following types of cookies:
          </p>
          <ul class="list-disc pl-6 mt-3 space-y-2">
            <li><strong>Essential cookies</strong> — required for basic Site functionality such as page navigation and security. These cannot be disabled.</li>
            <li><strong>Analytics cookies</strong> — used by Google Analytics to understand usage patterns and improve the Site experience.</li>
            <li><strong>Advertising cookies</strong> — used by Google AdSense and advertising partners to serve relevant ads and measure ad performance.</li>
          </ul>
          <p class="mt-4">
            You can control cookies through your browser settings. Most browsers allow you to refuse or delete cookies. Be aware that disabling cookies may affect the functionality of this and other websites you visit.
          </p>
        </div>

        <!-- Google AdSense -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Google AdSense &amp; Advertising</h2>
          <p>
            This Site may display advertisements served by <strong>Google AdSense</strong>. Google and its advertising partners use cookies to serve ads based on your prior visits to this Site or other websites. Google's use of advertising cookies enables it and its partners to serve ads to you based on your browsing activity.
          </p>
          <p class="mt-4">
            You may opt out of personalized advertising by visiting <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer" class="text-[var(--color-gold-dark)] underline hover:no-underline">Google Ads Settings</a>. Alternatively, you can opt out of third-party vendor cookie usage at <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener noreferrer" class="text-[var(--color-gold-dark)] underline hover:no-underline">www.aboutads.info</a>.
          </p>
        </div>

        <!-- How I Use Your Information -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">How I Use Your Information</h2>
          <p>I use the information collected through this Site to:</p>
          <ul class="list-disc pl-6 mt-3 space-y-2">
            <li>Respond to contact form submissions and project inquiries.</li>
            <li>Evaluate potential consulting and development engagements.</li>
            <li>Analyze Site traffic and usage to improve content and user experience.</li>
            <li>Maintain Site security and prevent abuse.</li>
            <li>Comply with legal obligations when required.</li>
          </ul>
        </div>

        <!-- Data Retention -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Data Retention</h2>
          <p>
            Contact form submissions are retained for as long as necessary to respond to your inquiry and manage any resulting professional engagement. Analytics data is retained according to Google Analytics default retention settings (currently 14 months). You may request deletion of your personal data at any time by contacting me directly.
          </p>
        </div>

        <!-- Data Sharing -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Data Sharing &amp; Third Parties</h2>
          <p>I do not sell your personal information. Your data may be shared with the following third-party services that help operate this Site:</p>
          <ul class="list-disc pl-6 mt-3 space-y-2">
            <li><strong>Google Analytics</strong> — for website traffic analysis.</li>
            <li><strong>Google AdSense</strong> — for serving advertisements.</li>
            <li><strong>Cloudflare</strong> — for content delivery, DNS, security, and site hosting (Cloudflare Pages).</li>
          </ul>
          <p class="mt-4">
            Each of these services operates under its own privacy policy. I encourage you to review their respective policies for details on how they handle your data.
          </p>
        </div>

        <!-- Your Rights -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Your Rights</h2>
          <p>Depending on your location, you may have the following rights regarding your personal data:</p>
          <ul class="list-disc pl-6 mt-3 space-y-2">
            <li><strong>Access</strong> — request a copy of the personal data I hold about you.</li>
            <li><strong>Correction</strong> — request correction of inaccurate personal data.</li>
            <li><strong>Deletion</strong> — request deletion of your personal data.</li>
            <li><strong>Objection</strong> — object to processing of your personal data for certain purposes.</li>
            <li><strong>Data portability</strong> — request transfer of your data in a structured, machine-readable format.</li>
          </ul>
          <p class="mt-4">
            To exercise any of these rights, please contact me at <a href="mailto:mr.jwswain@gmail.com" class="text-[var(--color-gold-dark)] underline hover:no-underline">mr.jwswain@gmail.com</a>.
          </p>
        </div>

        <!-- Children's Privacy -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Children's Privacy</h2>
          <p>
            This Site is not directed at individuals under the age of 16. I do not knowingly collect personal information from children. If you believe a child has provided personal information through this Site, please contact me immediately so I can take appropriate action to remove it.
          </p>
        </div>

        <!-- Security -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Security</h2>
          <p>
            I take reasonable technical and organizational measures to protect your personal information against unauthorized access, alteration, disclosure, or destruction. This Site is served over HTTPS and hosted on Cloudflare's infrastructure, which provides DDoS protection, SSL/TLS encryption, and Web Application Firewall (WAF) capabilities. However, no method of transmission or storage is 100% secure, and I cannot guarantee absolute security.
          </p>
        </div>

        <!-- Changes to This Policy -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Changes to This Policy</h2>
          <p>
            I may update this Privacy Policy from time to time to reflect changes in my practices, technologies, or legal requirements. Any changes will be posted on this page with an updated "Last updated" date. I encourage you to review this policy periodically.
          </p>
        </div>

        <!-- Contact -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Contact</h2>
          <p>
            If you have any questions or concerns about this Privacy Policy or how your data is handled, please contact me:
          </p>
          <ul class="list-none mt-4 space-y-2">
            <li><strong>Mr. Swain</strong> — AI Developer &amp; Automation Engineer</li>
            <li>Email: <a href="mailto:mr.jwswain@gmail.com" class="text-[var(--color-gold-dark)] underline hover:no-underline">mr.jwswain@gmail.com</a></li>
            <li>Website: <a href="https://swain.pro" class="text-[var(--color-gold-dark)] underline hover:no-underline">swain.pro</a></li>
            <li>Location: Atlanta, GA</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>
