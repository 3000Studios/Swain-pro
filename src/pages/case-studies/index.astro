---
import BaseLayout from '../../layouts/BaseLayout.astro'
import HeroVideo from '../../components/HeroVideo.astro'
import SpiderWebBg from '../../components/backgrounds/SpiderWebBg'
import AquariumBg from '../../components/backgrounds/AquariumBg'
import LavaBg from '../../components/backgrounds/LavaBg'
import { caseStudies } from '../../data/caseStudies'
---

<BaseLayout
  title="Case Studies — Mr. Swain AI Developer"
  description="Detailed case studies on AI automation, LLM integration, and workflow automation projects by Mr. Swain. Real problems, real solutions, real outcomes."
>

  <!-- Hero (dark) -->
  <section class="section-dark relative overflow-hidden min-h-[80vh] flex items-center">
    <HeroVideo src="/videos/hero-case-studies.mp4" />
    <SpiderWebBg client:only="react" />
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 py-24 lg:py-32">
      <div class="max-w-2xl">
        <p class="section-label">Case Studies</p>
        <h1 class="text-5xl sm:text-6xl font-black mb-6 text-[var(--color-text)]">
          Problems Solved,<br /><span class="gradient-text">Outcomes Measured</span>
        </h1>
        <p class="text-[var(--color-dim)] text-xl leading-relaxed">
          Detailed breakdowns of real AI and automation projects — the problem, the solution, the stack, and the results. No hypotheticals, no demos that never shipped.
        </p>
      </div>
    </div>
  </section>

  <!-- Case studies (alternating light/dark feel via cards) -->
  <section class="section-light relative overflow-hidden">
    <AquariumBg client:only="react" />
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 py-28">
      <div class="space-y-6">
        {caseStudies.map((cs, i) => (
          <article
            class={`reveal-up card-light rounded-[var(--radius-card)] p-8 sm:p-10 ${i === 0 ? 'ring-1 ring-[var(--color-gold)] ring-opacity-30' : ''}`}
            style={`--delay:${i * 80}ms`}
          >
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
              <div class="lg:col-span-2">
                <div class="flex flex-wrap gap-2 mb-5">
                  <span class="badge badge-gold">{cs.category}</span>
                  <span class="badge badge-purple font-mono">{cs.year}</span>
                </div>
                <h2 class="text-2xl sm:text-3xl font-black text-[var(--color-onyx)] mb-2">
                  <a href={`/case-studies/${cs.slug}`} class="hover:text-[var(--color-gold-dark)] transition-colors">
                    {cs.title}
                  </a>
                </h2>
                <p class="text-[var(--color-gold-dark)] text-sm font-semibold mb-4">{cs.subtitle}</p>
                <p class="text-[var(--color-onyx)]/60 leading-relaxed text-sm mb-7">{cs.problem.slice(0, 280)}...</p>
                <a href={`/case-studies/${cs.slug}`} class="btn-primary text-sm">
                  Read Full Case Study
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>

              <div class="space-y-5">
                <div>
                  <p class="text-[0.65rem] font-mono font-semibold text-[var(--color-onyx)]/40 uppercase tracking-[0.12em] mb-3">Key Outcomes</p>
                  <ul class="space-y-2">
                    {cs.outcome.slice(0, 3).map(o => (
                      <li class="flex items-start gap-2 text-sm text-[var(--color-onyx)]/65">
                        <span class="text-[var(--color-emerald)] shrink-0 font-bold">✓</span>
                        {o}
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <p class="text-[0.65rem] font-mono font-semibold text-[var(--color-onyx)]/40 uppercase tracking-[0.12em] mb-3">Stack</p>
                  <div class="flex flex-wrap gap-1.5">
                    {cs.tech.slice(0, 5).map(t => (
                      <span class="px-2 py-0.5 rounded text-[10px] font-mono text-[var(--color-onyx)]/50 bg-[var(--color-onyx)]/[0.06] border border-[var(--color-border-light)]">
                        {t}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA (dark) -->
  <section class="section-dark relative overflow-hidden">
    <LavaBg client:only="react" />
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 py-24">
      <div class="reveal-up max-w-xl">
        <h2 class="text-3xl font-black mb-5 text-[var(--color-text)]">Have a similar challenge?</h2>
        <p class="text-[var(--color-dim)] mb-10 text-lg leading-relaxed">
          These are the kinds of problems I solve. If yours sounds familiar, let's talk about what the right solution looks like.
        </p>
        <a href="/contact" class="btn-primary">Start a Conversation</a>
      </div>
    </div>
  </section>

</BaseLayout>
