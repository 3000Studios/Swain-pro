---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { caseStudies } from '../../data/caseStudies'

const colorMap: Record<string, string> = {
  cyan: 'badge-cyan',
  purple: 'badge-purple',
  emerald: 'badge-emerald',
  amber: 'badge-amber',
  rose: 'badge-cyan',
}
---

<BaseLayout
  title="Case Studies — Jeremy Swain AI Developer"
  description="Detailed case studies on AI automation, LLM integration, and workflow automation projects by Jeremy Swain. Real problems, real solutions, real outcomes."
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-20">
    <div class="max-w-2xl mb-16">
      <p class="section-label">Case Studies</p>
      <h1 class="text-4xl sm:text-5xl font-black mb-5">
        Problems Solved,<br /><span class="gradient-text">Outcomes Measured</span>
      </h1>
      <p class="text-[var(--color-dim)] text-lg leading-relaxed">
        Detailed breakdowns of real AI and automation projects — the problem, the solution,
        the stack, and the results. No hypotheticals, no demos that never shipped.
      </p>
    </div>

    <div class="space-y-6">
      {caseStudies.map((cs, i) => (
        <article class={`reveal card p-8 ${i === 0 ? 'border-[var(--color-border-glow)]' : ''}`}>
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2">
              <div class="flex flex-wrap gap-2 mb-4">
                <span class={`badge ${colorMap[cs.heroColor] ?? 'badge-cyan'}`}>
                  {cs.icon} {cs.category}
                </span>
                <span class="badge badge-purple font-mono">{cs.year}</span>
              </div>
              <h2 class="text-2xl font-black text-[var(--color-text)] mb-2">
                <a href={`/case-studies/${cs.slug}`} class="hover:text-[var(--color-cyan)] transition-colors">
                  {cs.title}
                </a>
              </h2>
              <p class="text-[var(--color-cyan)] text-sm font-medium mb-4">{cs.subtitle}</p>
              <p class="text-[var(--color-dim)] leading-relaxed text-sm mb-6">{cs.problem.slice(0, 280)}...</p>
              <a href={`/case-studies/${cs.slug}`} class="btn-outline text-sm">
                Read Full Case Study
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>

            <div class="space-y-4">
              <div>
                <p class="text-xs font-semibold text-[var(--color-muted)] uppercase tracking-wider mb-2">Key Outcomes</p>
                <ul class="space-y-1.5">
                  {cs.outcome.slice(0, 3).map(o => (
                    <li class="flex items-start gap-2 text-xs text-[var(--color-dim)]">
                      <span class="text-[var(--color-emerald)] shrink-0">✓</span>
                      {o}
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="text-xs font-semibold text-[var(--color-muted)] uppercase tracking-wider mb-2">Stack</p>
                <div class="flex flex-wrap gap-1">
                  {cs.tech.slice(0, 5).map(t => (
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono text-[var(--color-muted)] bg-white/5 border border-[var(--color-border)]">
                      {t}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
