---
import BaseLayout from '../../layouts/BaseLayout.astro'
import LightningBg from '../../components/backgrounds/LightningBg'
import HexGridBg from '../../components/backgrounds/HexGridBg'
import HeroVideo from '../../components/HeroVideo.astro'
import { blogPosts } from '../../data/blog'

const categories = Array.from(new Set(blogPosts.map(p => p.category)))
---

<BaseLayout
  title="Blog & Insights — Mr. Swain AI Developer"
  description="Practical articles on AI automation, LLM integration, Python for business, and workflow automation by Mr. Swain."
>

  <!-- Hero (dark) -->
  <section class="section-dark relative overflow-hidden min-h-[80vh] flex items-center">
    <HeroVideo src="/videos/hero-blog.mp4" />
    <LightningBg client:only="react" />
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 py-24 lg:py-32">
      <div class="max-w-2xl">
        <p class="section-label">Writing</p>
        <h1 class="text-5xl sm:text-6xl font-black mb-6 text-[var(--color-text)]">
          Blog &amp;<br /><span class="gradient-text">Insights</span>
        </h1>
        <p class="text-[var(--color-dim)] text-xl leading-relaxed">
          Practical writing on AI automation, LLM systems, Python for business, and workflow engineering. No hype. No fluff. Just what actually works.
        </p>
      </div>
    </div>
  </section>

  <!-- Posts (light) -->
  <section class="section-light relative overflow-hidden">
    <HexGridBg client:only="react" />
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 py-24">

      <!-- Category filter -->
      <div class="flex flex-wrap gap-2 mb-12 reveal-up" role="list" aria-label="Blog categories">
        {['All', ...categories].map(cat => (
          <button
            data-filter={cat}
            class={`filter-btn px-3.5 py-1.5 rounded-full text-xs font-semibold font-mono uppercase tracking-wider transition-all duration-200 border ${cat === 'All' ? 'bg-[var(--color-onyx)] text-[var(--color-gold)] border-[var(--color-onyx)] is-active' : 'bg-transparent text-[var(--color-onyx)]/50 border-[var(--color-border-light)] hover:border-[var(--color-onyx)]/30'}`}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="posts-grid" data-stagger-parent>
        {blogPosts.map((post, i) => (
          <article
            class="reveal-scale card-light rounded-[var(--radius-card)] p-6 flex flex-col"
            style={`--delay:${i * 60}ms`}
            data-category={post.category}
            data-stagger
          >
            <div class="flex items-center gap-2 mb-4">
              <span class="badge badge-gold">{post.category}</span>
              <span class="text-xs text-[var(--color-onyx)]/40 font-mono">{post.readTime}</span>
            </div>
            <h2 class="font-bold text-[var(--color-onyx)] leading-tight mb-3 flex-1 text-base">
              <a href={`/blog/${post.slug}`} class="hover:text-[var(--color-gold-dark)] transition-colors">
                {post.title}
              </a>
            </h2>
            <p class="text-sm text-[var(--color-onyx)]/55 leading-relaxed mb-5">{post.description}</p>
            <div class="flex flex-wrap gap-1 mb-5">
              {post.tags.slice(0, 3).map(tag => (
                <span class="px-2 py-0.5 rounded text-[10px] font-mono text-[var(--color-onyx)]/40 bg-[var(--color-onyx)]/[0.05] border border-[var(--color-border-light)]">
                  #{tag}
                </span>
              ))}
            </div>
            <div class="flex items-center justify-between mt-auto pt-4 border-t border-[var(--color-border-light)]">
              <time class="text-xs font-mono text-[var(--color-onyx)]/40" datetime={post.date}>
                {new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </time>
              <a href={`/blog/${post.slug}`} class="text-xs text-[var(--color-gold-dark)] font-semibold hover:text-[var(--color-gold)] flex items-center gap-1 transition-colors">
                Read
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const btns  = document.querySelectorAll<HTMLButtonElement>('.filter-btn')
  const posts = document.querySelectorAll<HTMLElement>('[data-category]')

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter')

      btns.forEach(b => {
        b.classList.remove('bg-[var(--color-onyx)]', 'text-[var(--color-gold)]', 'border-[var(--color-onyx)]', 'is-active')
        b.classList.add('bg-transparent', 'text-[var(--color-onyx)]/50', 'border-[var(--color-border-light)]')
      })
      btn.classList.add('bg-[var(--color-onyx)]', 'text-[var(--color-gold)]', 'border-[var(--color-onyx)]', 'is-active')
      btn.classList.remove('bg-transparent', 'text-[var(--color-onyx)]/50', 'border-[var(--color-border-light)]')

      posts.forEach(post => {
        const show = filter === 'All' || post.getAttribute('data-category') === filter
        post.style.display = show ? '' : 'none'
      })
    })
  })
</script>
