<script>
  /* ── Hero entrance — staggered clip-wipe per line ── */
  const heroLines = document.querySelectorAll<HTMLElement>('.hero-line')
  const heroSubs  = ['.hero-sub', '.hero-tags', '.hero-cta', '.hero-stats'].map(
    (s) => document.querySelector<HTMLElement>(s)
  )

  heroLines.forEach((el) => {
    el.style.transform = 'translateY(110%)'
    el.style.opacity   = '1'
  })
  heroSubs.forEach((el) => {
    if (el) { el.style.opacity = '0'; el.style.transform = 'translateY(20px)' }
  })

  const easeOut = 'cubic-bezier(0.16, 1, 0.3, 1)'

  heroLines.forEach((el, i) => {
    setTimeout(() => {
      el.style.transition = `transform 1s ${easeOut}, opacity 0.8s ease`
      el.style.transform  = 'translateY(0)'
    }, 150 + i * 180)
  })

  heroSubs.forEach((el, i) => {
    if (!el) return
    setTimeout(() => {
      el.style.transition = `opacity 0.7s ease, transform 0.7s ${easeOut}`
      el.style.opacity    = '1'
      el.style.transform  = 'translateY(0)'
    }, 700 + i * 120)
  })

  /* ── Device orientation parallax on hero ── */
  const heroContent = document.querySelector<HTMLElement>('.hero-content')
  window.addEventListener('deviceorientation', (e: DeviceOrientationEvent) => {
    if (!heroContent || e.gamma == null || e.beta == null) return
    heroContent.style.transform = `translate(${(e.gamma / 40) * 7}px, ${((e.beta - 45) / 40) * 4}px)`
  }, { passive: true })
</script>
