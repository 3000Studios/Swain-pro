---
import BaseLayout from '../layouts/BaseLayout.astro'
import WaveGridBg from '../components/backgrounds/WaveGridBg'
import PlasmaBg from '../components/backgrounds/PlasmaBg'
import GalaxyBg from '../components/backgrounds/GalaxyBg'
import LightningBg from '../components/backgrounds/LightningBg'
import FluidInkBg from '../components/backgrounds/FluidInkBg'
import SpiderWebBg from '../components/backgrounds/SpiderWebBg'
import HeroCanvas3D from '../components/HeroCanvas3D'
import SectionDivider from '../components/SectionDivider.astro'
import { featuredProjects } from '../data/projects'
import { blogPosts } from '../data/blog'

const recentPosts = blogPosts.slice(0, 3)
---

<BaseLayout
  title="Mr. Swain — AI Developer & Automation Engineer | Atlanta, GA"
  description="Mr. Swain builds scalable AI systems, automation workflows, LLM integrations, and intelligent tools that solve real business problems and deploy to production."
>

  <!-- ════════════════════════════════════════
       SECTION 1 · HERO  (DARK)
  ════════════════════════════════════════ -->
  <section class="section-dark relative min-h-screen flex items-center overflow-hidden" aria-label="Hero">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-24 -left-24 w-[30rem] h-[30rem] rounded-full bg-[rgba(130,247,255,0.16)] blur-3xl"></div>
      <div class="absolute top-10 right-0 w-[28rem] h-[28rem] rounded-full bg-[rgba(183,156,255,0.14)] blur-3xl"></div>
      <div class="absolute bottom-0 left-1/3 w-[38rem] h-[18rem] rounded-full bg-[rgba(255,111,145,0.12)] blur-3xl"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.06),transparent_45%)]"></div>
    </div>

    <HeroCanvas3D client:only="react" />
    <WaveGridBg client:only="react" />

    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 py-20 sm:py-28 lg:py-36 w-full">
      <div class="grid lg:grid-cols-[1.2fr_0.8fr] gap-10 lg:gap-16 items-center">
        <div class="hero-content max-w-3xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-4 py-2 mb-8 backdrop-blur-xl">
            <span class="w-2 h-2 rounded-full bg-[var(--color-emerald)] shadow-[0_0_18px_rgba(70,242,194,0.85)]" aria-hidden="true"></span>
            <span class="font-mono text-[0.68rem] text-[var(--color-text)]/80 tracking-[0.22em] uppercase">
              Available for AI Projects &amp; Consulting
            </span>
          </div>

          <h1 class="text-[2.8rem] sm:text-6xl lg:text-7xl xl:text-[5.8rem] font-black leading-[0.95] mb-6 tracking-tight">
            <span class="block overflow-hidden">
              <span class="hero-line block text-[var(--color-text)]">Sleek AI</span>
            </span>
            <span class="block overflow-hidden">
              <span class="hero-line block gradient-text-animated">With Chrome</span>
            </span>
            <span class="block overflow-hidden">
              <span class="hero-line block text-[var(--color-text)]">Energy.</span>
            </span>
          </h1>

          <p class="hero-sub text-base sm:text-xl text-[var(--color-dim)] leading-relaxed mb-6 max-w-2xl">
            Mr. Swain builds production AI systems, automation workflows, and edge-native products with a premium finish: fast, cinematic, and built to ship.
          </p>

          <div class="hero-tags flex flex-wrap gap-2 mb-8">
            {['AI Systems', 'Automation', 'LLMs', 'Cloudflare Edge', 'Business Strategy'].map((role) => (
              <span class="badge badge-gold">{role}</span>
            ))}
          </div>

          <div class="hero-cta flex flex-wrap gap-3 sm:gap-4 mb-8">
            <a href="/contact" class="btn-primary text-sm px-7 py-3.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
              </svg>
              Contact
            </a>
            <a href="/projects" class="btn-outline text-sm px-7 py-3.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
              </svg>
              View Projects
            </a>
          </div>

          <div class="hero-stats grid grid-cols-3 gap-3 sm:gap-4 max-w-xl">
            {[
              { value: '7+', label: 'Years Exp.' },
              { value: '13+', label: 'Live Projects' },
              { value: '14', label: 'Live Domains' },
            ].map((stat) => (
              <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-4 backdrop-blur-xl shadow-[0_12px_40px_rgba(0,0,0,0.18)]">
                <div class="text-3xl sm:text-4xl font-black gradient-text-animated tabular-nums">{stat.value}</div>
                <div class="text-[0.68rem] text-[var(--color-muted)] mt-1 leading-tight uppercase tracking-[0.18em]">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>

        <div class="relative">
          <div class="absolute inset-0 -m-8 rounded-[2rem] bg-[radial-gradient(circle_at_30%_20%,rgba(130,247,255,0.24),transparent_30%),radial-gradient(circle_at_75%_75%,rgba(183,156,255,0.2),transparent_28%)] blur-2xl"></div>
          <div class="relative rounded-[2rem] border border-white/10 bg-white/[0.04] p-5 sm:p-6 backdrop-blur-2xl shadow-[0_35px_120px_rgba(0,0,0,0.35)]">
            <div class="flex items-center justify-between mb-4">
              <div>
                <p class="font-mono text-[0.6rem] tracking-[0.28em] text-[var(--color-muted)] uppercase">Chromatic Surface</p>
                <p class="text-sm text-[var(--color-text)]/80 mt-1">Premium systems, tuned for conversion.</p>
              </div>
              <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 font-mono text-[0.6rem] tracking-[0.22em] uppercase text-[var(--color-gold)]">Live</span>
            </div>
            <div class="grid gap-3">
              <div class="rounded-2xl border border-white/8 bg-[linear-gradient(135deg,rgba(255,255,255,0.08),rgba(255,255,255,0.02))] p-4">
                <div class="flex items-center justify-between">
                  <span class="text-sm text-[var(--color-text)]/85">AI Strategy</span>
                  <span class="font-mono text-[0.62rem] text-[var(--color-cyan)] tracking-[0.2em] uppercase">40+ patterns</span>
                </div>
              </div>
              <div class="rounded-2xl border border-white/8 bg-[linear-gradient(135deg,rgba(111,124,255,0.18),rgba(130,247,255,0.06))] p-4">
                <div class="flex items-center justify-between">
                  <span class="text-sm text-[var(--color-text)]/85">Automation Delivery</span>
                  <span class="font-mono text-[0.62rem] text-[var(--color-gold-light)] tracking-[0.2em] uppercase">Production grade</span>
                </div>
              </div>
              <div class="rounded-2xl border border-white/8 bg-[linear-gradient(135deg,rgba(255,255,255,0.08),rgba(183,156,255,0.06))] p-4">
                <div class="flex items-center justify-between">
                  <span class="text-sm text-[var(--color-text)]/85">Edge Deployment</span>
                  <span class="font-mono text-[0.62rem] text-[var(--color-emerald)] tracking-[0.2em] uppercase">Cloudflare Pages</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 scroll-indicator" aria-hidden="true">
      <span class="font-mono text-[0.58rem] text-[var(--color-muted)] tracking-[0.18em] uppercase">Scroll</span>
      <svg class="w-4 h-4 text-[var(--color-gold)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
  </section>


  <SectionDivider variant="wave" />

  <!-- ════════════════════════════════════════
       SECTION 2 · ABOUT PREVIEW  (LIGHT)
  ════════════════════════════════════════ -->
  <section class="section-light relative overflow-hidden" aria-label="About Mr. Swain">
    <!-- Section 2 background: aquarium with tsunami mouse effect -->
    <FluidInkBg client:only="react" />
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 py-28">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">

        <div class="reveal-left">
          <p class="section-label">About</p>
          <h2 class="text-4xl sm:text-5xl font-black mb-7 leading-tight text-[var(--color-onyx)]">
            Technical Depth Meets<br />
            <span class="gradient-text">Business Fluency</span>
          </h2>
          <p class="text-[var(--color-onyx)]/70 leading-relaxed mb-4 text-[1.05rem]">
            Based in Atlanta, GA — I design and build AI systems that go beyond demos into production. With a background spanning enterprise consulting at Capgemini, private AI development, and full-stack deployment on Cloudflare, I bridge what AI can do with what businesses actually need.
          </p>
          <p class="text-[var(--color-onyx)]/60 leading-relaxed mb-10">
            Every system is end-to-end: requirements, architecture, implementation, deployment, monitoring. No half-finished handoffs. No proof-of-concept that never ships.
          </p>
          <a href="/about" class="btn-primary">
            Full Background
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <!-- Capability cards on light bg -->
        <div class="reveal-right grid grid-cols-2 gap-3 sm:gap-4" data-stagger-parent>
          {[
            {
              title: 'LLM Integration',
              desc: 'GPT-4, Claude, Gemini, LangChain, multi-agent systems',
              icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1 1 .03 2.7-1.41 2.7H4.21c-1.44 0-2.41-1.7-1.41-2.7L4.2 15.3"/>`,
            },
            {
              title: 'Automation',
              desc: 'Python pipelines, RPA, document processing, API orchestration',
              icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12a7.5 7.5 0 0015 0m-15 0a7.5 7.5 0 1115 0m-15 0H3m16.5 0H21m-1.5 0H12m-8.457 3.077l1.41-.513m14.095-5.13l1.41-.513M5.106 17.785l1.15-.964m11.49-9.642l1.149-.964M7.501 19.795l.75-1.3m7.5-12.99l.75-1.3m-6.063 16.658l.26-1.477m2.605-14.772l.26-1.477m0 17.726l-.26-1.477M10.698 4.614l-.26-1.477M16.5 19.794l-.75-1.299M7.5 4.205L12 12m6.894 5.785l-1.149-.964M6.256 7.178l-1.15-.964m15.352 8.864l-1.41-.513M4.954 9.435l-1.41-.514M12.002 12l-3.75 6.495"/>`,
            },
            {
              title: 'Business Analysis',
              desc: 'Requirements, Agile, Salesforce, dashboards, KPIs',
              icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>`,
            },
            {
              title: 'Edge Deployment',
              desc: 'Cloudflare Workers/Pages, edge-native, production-grade',
              icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/>`,
            },
          ].map((item, i) => (
            <div
              class="card-light p-4 sm:p-5 rounded-[var(--radius-card)] reveal-scale"
              style={`--delay:${i*80}ms`}
              data-stagger
            >
              <div class="w-10 h-10 rounded-lg bg-[var(--color-onyx)] text-[var(--color-gold)] flex items-center justify-center mb-4" set:html={item.icon}></div>
              <h3 class="font-bold text-[var(--color-onyx)] text-sm mb-1.5">{item.title}</h3>
              <p class="text-xs text-[var(--color-onyx)]/55 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>


  <SectionDivider variant="circuit" />

  <!-- ════════════════════════════════════════
       SECTION 3 · FEATURED PROJECTS  (DARK)
  ════════════════════════════════════════ -->
    <!-- Section 3 background: perspective 3D wireframe grid receding to horizon -->
    <GalaxyBg client:only="react" />
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 py-28">

      <div class="reveal-up flex items-end justify-between mb-14">
        <div>
          <p class="section-label">Work</p>
          <h2 class="text-4xl sm:text-5xl font-black text-[var(--color-text)]">
            Featured <span class="gradient-text">Projects</span>
          </h2>
        </div>
        <a href="/projects" class="btn-outline text-sm hidden sm:inline-flex">
          All Projects
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-stagger-parent>
        {featuredProjects.map((project, i) => (
          <article
            class={`reveal-scale card card-3d p-7 flex flex-col ${i === 0 ? 'md:col-span-2' : ''}`}
            style={`--delay:${i * 100}ms; --gloss-delay:${i * 1.4}s`}
            data-stagger
          >
            {i === 0 ? (
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 h-full">
                <div class="lg:col-span-7 flex flex-col justify-between">
                  <div>
                    <div class="flex items-start justify-between gap-4 mb-5">
                      <div>
                        <div class="flex flex-wrap gap-2 mb-2.5">
                          <span class={`badge ${project.status === 'live' ? 'badge-emerald' : 'badge-gold'}`}>
                            {project.status}
                          </span>
                          <span class="badge badge-slate">{project.category}</span>
                        </div>
                        <h3 class="font-bold text-[var(--color-text)] text-2xl leading-tight">{project.name}</h3>
                      </div>
                      <div class="flex gap-2 shrink-0">
                        {project.url && (
                          <a href={project.url} target="_blank" rel="noopener noreferrer"
                             class="p-2 rounded-lg border border-[var(--color-border)] text-[var(--color-muted)] hover:text-[var(--color-gold)] hover:border-[var(--color-border-glow)] transition-colors"
                             aria-label={`Visit ${project.name}`}>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                            </svg>
                          </a>
                        )}
                        {project.github && (
                          <a href={project.github} target="_blank" rel="noopener noreferrer"
                             class="p-2 rounded-lg border border-[var(--color-border)] text-[var(--color-muted)] hover:text-[var(--color-gold)] hover:border-[var(--color-border-glow)] transition-colors"
                             aria-label={`${project.name} on GitHub`}>
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                            </svg>
                          </a>
                        )}
                      </div>
                    </div>
                    <p class="text-[var(--color-dim)] leading-relaxed mb-5">{project.description}</p>
                    <ul class="mb-5 space-y-2">
                      {project.highlights.map(h => (
                        <li class="flex items-start gap-2.5 text-sm text-[var(--color-dim)]">
                          <span class="text-[var(--color-gold)] text-xs mt-0.5 shrink-0">▸</span>
                          {h}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="flex flex-wrap gap-1.5 mt-auto">
                    {project.tech.map(t => (
                      <span class="px-2 py-0.5 rounded text-[10px] font-mono text-[var(--color-muted)] bg-white/[0.04] border border-[var(--color-border)]">
                        {t}
                      </span>
                    ))}
                  </div>
                </div>
                <div class="lg:col-span-5 flex flex-col justify-center">
                  {project.screenshot && (
                    <div class="relative rounded-lg overflow-hidden border border-white/10 shadow-2xl bg-black/40 group/mockup">
                      <div class="flex items-center gap-1.5 px-3.5 py-2.5 bg-white/[0.03] border-b border-white/5">
                        <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></span>
                        <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></span>
                        <span class="ml-2 font-mono text-[10px] text-[var(--color-muted)] truncate max-w-[150px]">{project.url ? project.url.replace('https://', '') : 'localhost'}</span>
                      </div>
                      <div class="aspect-video w-full overflow-hidden bg-black/20">
                        <img
                          src={project.screenshot}
                          alt={`${project.name} screenshot`}
                          class="w-full h-full object-cover object-top transition-transform duration-500 group-hover/mockup:scale-105"
                          loading="lazy"
                        />
                      </div>
                    </div>
                  )}
                </div>
              </div>
            ) : (
              <div class="flex flex-col h-full justify-between">
                <div>
                  <div class="flex items-start justify-between gap-4 mb-5">
                    <div>
                      <div class="flex flex-wrap gap-2 mb-2.5">
                        <span class={`badge ${project.status === 'live' ? 'badge-emerald' : 'badge-gold'}`}>
                          {project.status}
                        </span>
                        <span class="badge badge-slate">{project.category}</span>
                      </div>
                      <h3 class="font-bold text-[var(--color-text)] text-xl leading-tight">{project.name}</h3>
                    </div>
                    <div class="flex gap-2 shrink-0">
                      {project.url && (
                        <a href={project.url} target="_blank" rel="noopener noreferrer"
                           class="p-2 rounded-lg border border-[var(--color-border)] text-[var(--color-muted)] hover:text-[var(--color-gold)] hover:border-[var(--color-border-glow)] transition-colors"
                           aria-label={`Visit ${project.name}`}>
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                          </svg>
                        </a>
                      )}
                      {project.github && (
                        <a href={project.github} target="_blank" rel="noopener noreferrer"
                           class="p-2 rounded-lg border border-[var(--color-border)] text-[var(--color-muted)] hover:text-[var(--color-gold)] hover:border-[var(--color-border-glow)] transition-colors"
                           aria-label={`${project.name} on GitHub`}>
                          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
