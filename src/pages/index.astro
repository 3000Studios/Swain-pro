---
import BaseLayout from '../layouts/BaseLayout.astro'
import NeuralCanvas from '../components/NeuralCanvas.tsx'
import JazzToggle from '../components/JazzToggle.tsx'
import { featuredProjects } from '../data/projects'
import { skillCategories, coreCompetencies } from '../data/skills'
import { blogPosts } from '../data/blog'

const recentPosts = blogPosts.slice(0, 3)
---

<BaseLayout
  title="Jeremy Swain — AI Developer & Automation Engineer | Atlanta, GA"
  description="Jeremy Swain builds scalable AI systems, automation workflows, LLM integrations, and intelligent tools. AI Developer, Automation Engineer, Python & LangChain Expert based in Atlanta, GA."
>
  <!-- ── HERO ─────────────────────────────────────────── -->
  <section
    class="relative min-h-[92vh] flex items-center overflow-hidden"
    aria-label="Hero section"
  >
    <!-- Neural background -->
    <div class="absolute inset-0 bg-[var(--color-bg)]">
      <NeuralCanvas client:only="react" />
      <!-- Gradient overlays -->
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[var(--color-bg)]" aria-hidden="true"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-bg)] via-transparent to-[var(--color-bg)] opacity-60" aria-hidden="true"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-20 lg:py-32">
      <div class="max-w-3xl">

        <!-- Tag -->
        <div class="flex items-center gap-2 mb-6">
          <div class="w-2 h-2 rounded-full bg-[var(--color-emerald)] animate-pulse" aria-hidden="true"></div>
          <span class="font-mono text-xs text-[var(--color-emerald)] tracking-widest uppercase">
            Available for AI Projects & Consulting
          </span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-black leading-[1.05] mb-6 tracking-tight">
          <span class="text-[var(--color-text)]">AI Systems</span>
          <br />
          <span class="gradient-text">That Actually Ship</span>
        </h1>

        <!-- Subhead -->
        <p class="text-lg sm:text-xl text-[var(--color-dim)] leading-relaxed mb-4 max-w-2xl">
          Jeremy Swain builds scalable LLM integrations, automation workflows, intelligent agents,
          and full-stack AI tools that solve real business problems — and deploy to production.
        </p>

        <!-- Role tags -->
        <div class="flex flex-wrap gap-2 mb-10">
          {['AI Developer', 'Automation Engineer', 'LLM Specialist', 'Python Expert', 'Business Analyst'].map(role => (
            <span class="badge badge-cyan">{role}</span>
          ))}
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4 mb-12">
          <a href="/contact" class="btn-primary text-sm px-6 py-3">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
            Hire Jeremy
          </a>
          <a href="/projects" class="btn-outline text-sm px-6 py-3">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
            </svg>
            View Projects
          </a>
        </div>

        <!-- Quick stats -->
        <div class="grid grid-cols-3 gap-6 max-w-sm">
          {[
            { value: '7+', label: 'Years Experience' },
            { value: '10+', label: 'AI Projects' },
            { value: '9', label: 'Live Domains' },
          ].map(stat => (
            <div>
              <div class="text-2xl font-black gradient-text">{stat.value}</div>
              <div class="text-xs text-[var(--color-muted)] mt-0.5">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce" aria-hidden="true">
      <span class="text-[10px] text-[var(--color-muted)] font-mono tracking-widest uppercase">Scroll</span>
      <svg class="w-4 h-4 text-[var(--color-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
  </section>

  <!-- ── ABOUT SNIPPET ───────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-24" aria-label="About Jeremy Swain">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="reveal">
        <p class="section-label">About</p>
        <h2 class="text-3xl sm:text-4xl font-black mb-6 leading-tight">
          Technical Depth Meets<br />
          <span class="gradient-text">Business Fluency</span>
        </h2>
        <p class="text-[var(--color-dim)] leading-relaxed mb-4">
          Based in Atlanta, GA — I design and build AI systems that go beyond demos into production.
          With a background spanning enterprise consulting at Capgemini, private AI development, and
          full-stack web deployment on Cloudflare, I bridge the gap between what AI can do and what
          businesses actually need.
        </p>
        <p class="text-[var(--color-dim)] leading-relaxed mb-8">
          Every system I build is end-to-end: requirements gathering, architecture, implementation,
          deployment, monitoring. No half-finished handoffs. No "proof of concept" that never ships.
        </p>
        <a href="/about" class="btn-outline">
          Full Background
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <div class="reveal grid grid-cols-2 gap-4">
        {[
          { icon: '🧠', title: 'LLM Integration', desc: 'GPT-4, Claude, Gemini, LangChain, multi-agent systems' },
          { icon: '⚙️', title: 'Automation', desc: 'Python pipelines, RPA, document processing, API orchestration' },
          { icon: '📊', title: 'Business Analysis', desc: 'Requirements, Agile, Salesforce, dashboards, KPIs' },
          { icon: '🚀', title: 'Deployment', desc: 'Cloudflare Workers/Pages, edge-native, production-grade' },
        ].map(item => (
          <div class="card p-5">
            <div class="text-2xl mb-3" aria-hidden="true">{item.icon}</div>
            <h3 class="font-semibold text-[var(--color-text)] text-sm mb-1.5">{item.title}</h3>
            <p class="text-xs text-[var(--color-muted)] leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FEATURED PROJECTS ───────────────────────────── -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-16 border-t border-[var(--color-border)]" aria-label="Featured projects">
    <div class="reveal flex items-end justify-between mb-12">
      <div>
        <p class="section-label">Work</p>
        <h2 class="text-3xl sm:text-4xl font-black">
          Featured <span class="gradient-text">Projects</span>
        </h2>
      </div>
      <a href="/projects" class="btn-outline text-sm hidden sm:inline-flex">
        All Projects
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredProjects.map((project, i) => (
        <article class={`reveal card p-6 ${i === 0 ? 'md:col-span-2' : ''}`}>
          <div class="flex items-start justify-between gap-4 mb-4">
            <div>
              <div class="flex flex-wrap gap-2 mb-2">
                <span class={`badge ${project.status === 'live' ? 'badge-emerald' : 'badge-cyan'}`}>
                  {project.status}
                </span>
                <span class="badge badge-purple">{project.category}</span>
              </div>
              <h3 class="font-bold text-[var(--color-text)] text-xl">{project.name}</h3>
            </div>
            <div class="flex gap-2 shrink-0">
              {project.url && (
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2 rounded-lg border border-[var(--color-border)] text-[var(--color-muted)] hover:text-[var(--color-cyan)] hover:border-[var(--color-border-glow)] transition-colors"
                  aria-label={`Visit ${project.name}`}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                </a>
              )}
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2 rounded-lg border border-[var(--color-border)] text-[var(--color-muted)] hover:text-[var(--color-cyan)] hover:border-[var(--color-border-glow)] transition-colors"
                  aria-label={`${project.name} GitHub repo`}
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                  </svg>
                </a>
              )}
            </div>
          </div>

          <p class="text-[var(--color-dim)] leading-relaxed mb-5">{project.longDescription}</p>

          <ul class="mb-5 space-y-1.5">
            {project.highlights.map(h => (
              <li class="flex items-start gap-2 text-sm text-[var(--color-dim)]">
                <span class="text-[var(--color-cyan)] text-xs mt-0.5 shrink-0">▸</span>
                {h}
              </li>
            ))}
          </ul>

          <div class="flex flex-wrap gap-1.5">
            {project.tech.map(t => (
              <span class="px-2 py-0.5 rounded text-[11px] font-mono text-[var(--color-muted)] bg-white/5 border border-[var(--color-border)]">
                {t}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>

    <div class="mt-8 sm:hidden">
      <a href="/projects" class="btn-outline w-full justify-center">All Projects</a>
    </div>
  </section>

  <!-- ── SKILLS ──────────────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-24 border-t border-[var(--color-border)]" aria-label="Skills and competencies">
    <div class="reveal mb-12">
      <p class="section-label">Expertise</p>
      <h2 class="text-3xl sm:text-4xl font-black">
        Technical <span class="gradient-text">Stack</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {skillCategories.map(cat => (
        <div class="reveal card p-5">
          <div class="flex items-center gap-3 mb-5">
            <span class="text-xl" aria-hidden="true">{cat.icon}</span>
            <h3 class="font-semibold text-[var(--color-text)] text-sm">{cat.label}</h3>
          </div>
          <div class="space-y-3">
            {cat.skills.map(skill => (
              <div>
                <div class="flex justify-between items-center mb-1">
                  <span class="text-xs text-[var(--color-dim)]">{skill.name}</span>
                  <span class="text-xs font-mono text-[var(--color-muted)]">{skill.level}%</span>
                </div>
                <div class="skill-bar-track">
                  <div class="skill-bar-fill" style={`width: ${skill.level}%`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Core competencies -->
    <div class="reveal">
      <h3 class="font-semibold text-[var(--color-text)] text-sm mb-4">Core Competencies</h3>
      <div class="flex flex-wrap gap-2">
        {coreCompetencies.map(c => (
          <span class="px-3 py-1.5 rounded-full text-xs font-medium text-[var(--color-dim)] bg-[var(--color-card)] border border-[var(--color-border)] hover:border-[var(--color-border-glow)] hover:text-[var(--color-cyan)] transition-colors cursor-default">
            {c}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ── BLOG PREVIEW ────────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-24 border-t border-[var(--color-border)]" aria-label="Recent blog posts">
    <div class="reveal flex items-end justify-between mb-12">
      <div>
        <p class="section-label">Insights</p>
        <h2 class="text-3xl sm:text-4xl font-black">
          Recent <span class="gradient-text">Writing</span>
        </h2>
      </div>
      <a href="/blog" class="btn-outline text-sm hidden sm:inline-flex">
        All Posts
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {recentPosts.map(post => (
        <article class="reveal card p-6 flex flex-col">
          <div class="flex items-center gap-2 mb-4">
            <span class="badge badge-purple">{post.category}</span>
            <span class="text-xs text-[var(--color-muted)]">{post.readTime}</span>
          </div>
          <h3 class="font-semibold text-[var(--color-text)] leading-tight mb-3 flex-1">
            <a href={`/blog/${post.slug}`} class="hover:text-[var(--color-cyan)] transition-colors">
              {post.title}
            </a>
          </h3>
          <p class="text-sm text-[var(--color-muted)] leading-relaxed mb-4">{post.description}</p>
          <div class="flex items-center justify-between mt-auto pt-4 border-t border-[var(--color-border)]">
            <time class="text-xs text-[var(--color-muted)] font-mono" datetime={post.date}>
              {new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </time>
            <a href={`/blog/${post.slug}`} class="text-xs text-[var(--color-cyan)] hover:underline flex items-center gap-1">
              Read
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ── CTA ────────────────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-24 border-t border-[var(--color-border)]" aria-label="Contact call to action">
    <div class="reveal max-w-2xl mx-auto text-center">
      <p class="section-label justify-center">Let's Build</p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black mb-6">
        Have a Problem Worth<br />
        <span class="gradient-text">Automating?</span>
      </h2>
      <p class="text-[var(--color-dim)] leading-relaxed mb-10 text-lg">
        Whether you need an LLM integration, an automation pipeline, a business
        intelligence dashboard, or a full AI strategy — let's talk.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/contact" class="btn-primary text-sm px-8 py-3.5">
          Start a Conversation
        </a>
        <a href="tel:+14046407734" class="btn-outline text-sm px-8 py-3.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          (404) 640-7734
        </a>
      </div>
    </div>
  </section>

  <!-- Jazz toggle (global) -->
  <JazzToggle client:only="react" />
</BaseLayout>
