---
import BaseLayout from '../layouts/BaseLayout.astro'
import LightningBg from '../components/backgrounds/LightningBg'
import NeuralNetBg from '../components/backgrounds/NeuralNetBg'
---

<BaseLayout
  title="Terms of Service — Mr. Swain | swain.pro"
  description="Terms of service for swain.pro — the professional portfolio and services website of Mr. Swain, AI Developer & Automation Engineer."
>

  <!-- Hero (dark) -->
  <section class="section-dark relative overflow-hidden py-24 lg:py-32">
    <LightningBg client:only="react" />
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8">
      <div class="max-w-3xl">
        <p class="section-label">Legal</p>
        <h1 class="text-5xl sm:text-6xl font-black mb-6 text-[var(--color-text)]">
          Terms of <span class="gradient-text">Service</span>
        </h1>
        <p class="text-[var(--color-dim)] text-lg leading-relaxed">
          Last updated: June 9, 2026
        </p>
      </div>
    </div>
  </section>

  <!-- Content (light) -->
  <section class="section-light relative overflow-hidden">
    <NeuralNetBg client:only="react" light />
    <div class="relative z-10 max-w-4xl mx-auto px-5 sm:px-8 py-20">
      <div class="prose-policy space-y-12 text-[var(--color-onyx)]/80 leading-relaxed text-[1.05rem]">

        <!-- Agreement -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Agreement to Terms</h2>
          <p>
            By accessing or using <strong>swain.pro</strong> (the "Site"), you agree to be bound by these Terms of Service ("Terms"). The Site is owned and operated by Mr. Swain ("I," "me," or "my"), an AI Developer &amp; Automation Engineer based in Atlanta, GA. If you do not agree to these Terms, you must not access or use the Site.
          </p>
          <p class="mt-4">
            These Terms apply to all visitors, users, and others who access or use the Site. I reserve the right to update or modify these Terms at any time. Changes become effective when posted on this page with an updated date. Your continued use of the Site after any changes constitutes acceptance of the revised Terms.
          </p>
        </div>

        <!-- Description of the Site -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Description of the Site</h2>
          <p>
            This Site serves as a professional portfolio, blog, and services website. It showcases my work in AI development, automation engineering, LLM integration, and business analysis. The Site includes project case studies, professional background information, a blog, a contact form, and information about services I offer.
          </p>
          <p class="mt-4">
            The Site is provided on an "as is" and "as available" basis for informational and professional purposes.
          </p>
        </div>

        <!-- Intellectual Property -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Intellectual Property Rights</h2>
          <p>
            Unless otherwise indicated, all content on this Site — including but not limited to text, graphics, logos, images, code samples, blog posts, case studies, design elements, animations, and the overall look and feel — is my original work or used with permission and is protected by applicable intellectual property laws.
          </p>
          <p class="mt-4">You may:</p>
          <ul class="list-disc pl-6 mt-3 space-y-2">
            <li>View and browse the Site for personal, non-commercial purposes.</li>
            <li>Share links to pages on this Site.</li>
            <li>Reference or quote brief excerpts with proper attribution and a link back to the original page.</li>
          </ul>
          <p class="mt-4">You may not:</p>
          <ul class="list-disc pl-6 mt-3 space-y-2">
            <li>Reproduce, duplicate, copy, or redistribute substantial portions of the Site's content without written permission.</li>
            <li>Use my name, brand, or likeness to imply endorsement of your product or service without authorization.</li>
            <li>Scrape, crawl, or systematically extract content from the Site for commercial purposes without prior consent.</li>
            <li>Modify, create derivative works from, or reverse-engineer any part of the Site.</li>
          </ul>
        </div>

        <!-- User Conduct -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">User Conduct</h2>
          <p>When using this Site, you agree not to:</p>
          <ul class="list-disc pl-6 mt-3 space-y-2">
            <li>Use the Site for any unlawful purpose or in violation of any applicable laws or regulations.</li>
            <li>Attempt to gain unauthorized access to the Site, its servers, or any connected systems.</li>
            <li>Transmit viruses, malware, or any other malicious code through the contact form or other Site features.</li>
            <li>Submit false, misleading, or spam content through the contact form.</li>
            <li>Interfere with or disrupt the Site's infrastructure, availability, or performance.</li>
            <li>Impersonate me or any other person, or falsely represent your affiliation with any entity.</li>
            <li>Use automated tools to scrape, mirror, or replicate the Site without authorization.</li>
          </ul>
        </div>

        <!-- Contact Form -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Contact Form &amp; Communications</h2>
          <p>
            The contact form on this Site is provided as a convenience for you to reach me regarding potential projects, consulting engagements, employment opportunities, or general inquiries.
          </p>
          <p class="mt-4">
            By submitting information through the contact form, you acknowledge that:
          </p>
          <ul class="list-disc pl-6 mt-3 space-y-2">
            <li>Your submission does not create a professional engagement, contract, or obligation on my part.</li>
            <li>I may respond at my discretion and am under no obligation to respond to every inquiry.</li>
            <li>The information you submit will be handled in accordance with my <a href="/privacy" class="text-[var(--color-gold-dark)] underline hover:no-underline">Privacy Policy</a>.</li>
            <li>You are responsible for the accuracy of the information you submit.</li>
          </ul>
        </div>

        <!-- Services & Engagements -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Professional Services &amp; Engagements</h2>
          <p>
            Information about my services on this Site is provided for general informational purposes. It does not constitute a binding offer. Actual service engagements are subject to separate agreements, statements of work, or contracts negotiated on a per-project basis.
          </p>
          <p class="mt-4">
            Pricing, availability, scope, and delivery timelines are subject to change and are finalized only through explicit written agreement between both parties. Nothing on this Site guarantees specific results, outcomes, or deliverables.
          </p>
        </div>

        <!-- Blog & Content -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Blog &amp; Informational Content</h2>
          <p>
            Blog posts, articles, case studies, and other informational content published on this Site represent my professional opinions and experience at the time of writing. This content is provided for educational and informational purposes only.
          </p>
          <p class="mt-4">
            While I strive for accuracy, I make no guarantees that all information is current, complete, or error-free. Technology evolves rapidly — code examples, tool recommendations, and technical guidance may become outdated. Always verify against official documentation and current best practices before using any technical information in production systems.
          </p>
          <p class="mt-4">
            Content on this Site does not constitute professional advice (legal, financial, medical, or otherwise). For specific professional guidance, consult a qualified professional in the relevant field.
          </p>
        </div>

        <!-- Third-Party Links -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Third-Party Links &amp; Services</h2>
          <p>
            This Site may contain links to third-party websites, tools, and services (such as LinkedIn, GitHub, and others). These links are provided for convenience and reference only. I do not control, endorse, or assume responsibility for the content, privacy practices, or terms of any third-party site.
          </p>
          <p class="mt-4">
            Visiting third-party links is at your own risk. I encourage you to review the terms and privacy policies of any external site you visit.
          </p>
        </div>

        <!-- Disclaimers -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Disclaimers</h2>
          <p>
            THE SITE AND ITS CONTENT ARE PROVIDED "AS IS" AND "AS AVAILABLE" WITHOUT WARRANTIES OF ANY KIND, EITHER EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO IMPLIED WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, NON-INFRINGEMENT, OR ACCURACY.
          </p>
          <p class="mt-4">
            I do not warrant that the Site will be uninterrupted, error-free, secure, or free of viruses or other harmful components. I do not warrant that any defects will be corrected or that the Site or its server are free of malicious code.
          </p>
        </div>

        <!-- Limitation of Liability -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Limitation of Liability</h2>
          <p>
            TO THE MAXIMUM EXTENT PERMITTED BY APPLICABLE LAW, MR. SWAIN SHALL NOT BE LIABLE FOR ANY INDIRECT, INCIDENTAL, SPECIAL, CONSEQUENTIAL, OR PUNITIVE DAMAGES, OR ANY LOSS OF PROFITS, REVENUE, DATA, OR GOODWILL, ARISING OUT OF OR IN CONNECTION WITH YOUR USE OF OR INABILITY TO USE THE SITE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGES.
          </p>
          <p class="mt-4">
            IN NO EVENT SHALL MY TOTAL LIABILITY FOR ALL CLAIMS RELATED TO THE SITE EXCEED ONE HUNDRED U.S. DOLLARS ($100.00).
          </p>
        </div>

        <!-- Indemnification -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Indemnification</h2>
          <p>
            You agree to indemnify and hold harmless Mr. Swain from and against any claims, liabilities, damages, losses, costs, and expenses (including reasonable attorneys' fees) arising out of or in connection with your use of the Site, your violation of these Terms, or your violation of any rights of a third party.
          </p>
        </div>

        <!-- Governing Law -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Governing Law</h2>
          <p>
            These Terms shall be governed by and construed in accordance with the laws of the State of Georgia, United States, without regard to its conflict of law provisions. Any disputes arising under or in connection with these Terms shall be subject to the exclusive jurisdiction of the state and federal courts located in Fulton County, Georgia.
          </p>
        </div>

        <!-- Severability -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Severability</h2>
          <p>
            If any provision of these Terms is found to be invalid, illegal, or unenforceable by a court of competent jurisdiction, the remaining provisions shall continue in full force and effect. The invalid provision shall be modified to the minimum extent necessary to make it valid and enforceable while preserving its original intent.
          </p>
        </div>

        <!-- Contact -->
        <div>
          <h2 class="text-2xl font-black text-[var(--color-onyx)] mb-4">Contact</h2>
          <p>
            If you have any questions about these Terms of Service, please contact me:
          </p>
          <ul class="list-none mt-4 space-y-2">
            <li><strong>Mr. Swain</strong> — AI Developer &amp; Automation Engineer</li>
            <li>Email: <a href="mailto:mr.jwswain@gmail.com" class="text-[var(--color-gold-dark)] underline hover:no-underline">mr.jwswain@gmail.com</a></li>
            <li>Website: <a href="https://swain.pro" class="text-[var(--color-gold-dark)] underline hover:no-underline">swain.pro</a></li>
            <li>Location: Atlanta, GA</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>
