---
import BaseLayout from '../layouts/BaseLayout.astro'
import HeroVideo from '../components/HeroVideo.astro'
---

<BaseLayout
  title="Contact Mr. Swain — AI Developer & Automation Engineer"
  description="Contact Mr. Swain for AI development, automation engineering, LLM integration, or business analysis. Based in Atlanta, GA."
>

  <!-- Hero (dark) -->
  <section class="section-dark relative overflow-hidden min-h-[80vh] flex items-center">
    <HeroVideo src="/videos/hero-contact.mp4" />
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 py-24 lg:py-32">
      <div class="max-w-2xl">
        <p class="section-label">Get in Touch</p>
        <h1 class="text-5xl sm:text-6xl font-black mb-6 text-[var(--color-text)]">
          Let's Build<br /><span class="gradient-text">Something Real</span>
        </h1>
        <p class="text-[var(--color-dim)] text-xl leading-relaxed">
          Whether it's a scoped AI project, an automation consulting engagement, or a full-time role — I'd like to hear what you're working on.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact grid (light) -->
  <section class="section-light">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 py-28">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-20">

        <!-- Direct contact -->
        <div>
          <p class="section-label">Direct</p>
          <h2 class="text-3xl font-black mb-10 text-[var(--color-onyx)]">
            Fastest Ways to <span class="gradient-text">Reach Me</span>
          </h2>

          <div class="space-y-4">
            <a
              href="tel:+14046407734"
              class="reveal-left card-light p-5 flex items-center gap-5 group rounded-[var(--radius-card)]"
              aria-label="Call Mr. Swain"
            >
              <div class="w-12 h-12 rounded-xl bg-[var(--color-onyx)] text-[var(--color-gold)] flex items-center justify-center shrink-0 transition-transform group-hover:scale-110">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-[var(--color-onyx)] text-sm">Call or Text</p>
                <p class="text-[var(--color-gold-dark)] font-mono text-lg font-bold">(404) 640-7734</p>
                <p class="text-xs text-[var(--color-onyx)]/45">Atlanta, GA · Available EST</p>
              </div>
            </a>

            <a
              href="mailto:Mr.Jwswain@gmail.com"
              class="reveal-left card-light p-5 flex items-center gap-5 group rounded-[var(--radius-card)]"
              style="--delay:80ms"
              aria-label="Email Mr. Swain"
            >
              <div class="w-12 h-12 rounded-xl bg-[var(--color-onyx)] text-[var(--color-gold)] flex items-center justify-center shrink-0 transition-transform group-hover:scale-110">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-[var(--color-onyx)] text-sm">Email</p>
                <p class="text-[var(--color-gold-dark)] font-mono font-bold">Mr.Jwswain@gmail.com</p>
                <p class="text-xs text-[var(--color-onyx)]/45">Best for detailed project descriptions</p>
              </div>
            </a>

            <a
              href="https://www.linkedin.com/in/mrjwswain/"
              target="_blank"
              rel="noopener noreferrer"
              class="reveal-left card-light p-5 flex items-center gap-5 group rounded-[var(--radius-card)]"
              style="--delay:160ms"
              aria-label="LinkedIn profile"
            >
              <div class="w-12 h-12 rounded-xl bg-[#0a66c2] text-white flex items-center justify-center shrink-0 transition-transform group-hover:scale-110">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-[var(--color-onyx)] text-sm">LinkedIn</p>
                <p class="text-[#0a66c2] font-medium">linkedin.com/in/mrjwswain</p>
                <p class="text-xs text-[var(--color-onyx)]/45">Connect professionally</p>
              </div>
            </a>
          </div>

          <!-- Availability card -->
          <div class="reveal-up card-light p-5 mt-5 rounded-[var(--radius-card)] ring-1 ring-[var(--color-emerald)] ring-opacity-30">
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2 h-2 rounded-full bg-[var(--color-emerald)] animate-pulse" aria-hidden="true"></span>
              <span class="text-sm font-semibold text-[var(--color-emerald)]">Available Now</span>
            </div>
            <p class="text-sm text-[var(--color-onyx)]/55">
              Currently accepting new projects, consulting engagements, and full-time opportunities. Based in Atlanta, GA. Open to remote work.
            </p>
          </div>
        </div>

        <!-- Form -->
        <div>
          <p class="section-label">Inquire</p>
          <h2 class="text-3xl font-black mb-10 text-[var(--color-onyx)]">
            Describe Your <span class="gradient-text">Project</span>
          </h2>

          <form id="contact-form" class="space-y-5" novalidate>
            <div>
              <label for="name" class="block text-sm font-semibold text-[var(--color-onyx)]/70 mb-1.5">Name</label>
              <input
                type="text" id="name" name="name" required autocomplete="name"
                placeholder="Your name"
                class="w-full px-4 py-3 rounded-[var(--radius-sm)] bg-white border border-[var(--color-border-light)] text-[var(--color-onyx)] placeholder:text-[var(--color-onyx)]/30 focus:outline-none focus:ring-2 focus:ring-[var(--color-gold)] transition-all text-sm"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-[var(--color-onyx)]/70 mb-1.5">Email</label>
              <input
                type="email" id="email" name="email" required autocomplete="email"
                placeholder="your@email.com"
                class="w-full px-4 py-3 rounded-[var(--radius-sm)] bg-white border border-[var(--color-border-light)] text-[var(--color-onyx)] placeholder:text-[var(--color-onyx)]/30 focus:outline-none focus:ring-2 focus:ring-[var(--color-gold)] transition-all text-sm"
              />
            </div>
            <div>
              <label for="project-type" class="block text-sm font-semibold text-[var(--color-onyx)]/70 mb-1.5">Project Type</label>
              <select
                id="project-type" name="type"
                class="w-full px-4 py-3 rounded-[var(--radius-sm)] bg-white border border-[var(--color-border-light)] text-[var(--color-onyx)] focus:outline-none focus:ring-2 focus:ring-[var(--color-gold)] transition-all text-sm"
              >
                <option value="">Select a category...</option>
                <option value="AI Development">AI Development</option>
                <option value="Automation Engineering">Automation Engineering</option>
                <option value="LLM Integration">LLM Integration</option>
                <option value="AI Consulting">AI Strategy &amp; Consulting</option>
                <option value="Business Analysis">Business Analysis</option>
                <option value="Full-Time Role">Full-Time Role</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-semibold text-[var(--color-onyx)]/70 mb-1.5">Project Description</label>
              <textarea
                id="message" name="message" rows={5} required
                placeholder="Describe your project or challenge. What's the problem you're trying to solve? What's the expected outcome?"
                class="w-full px-4 py-3 rounded-[var(--radius-sm)] bg-white border border-[var(--color-border-light)] text-[var(--color-onyx)] placeholder:text-[var(--color-onyx)]/30 focus:outline-none focus:ring-2 focus:ring-[var(--color-gold)] transition-all text-sm resize-none"
              ></textarea>
            </div>
            <button type="submit" class="btn-primary w-full justify-center py-3.5">
              Send Message
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
              </svg>
            </button>
            <div id="form-status" role="status" aria-live="polite" class="text-sm"></div>
          </form>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const form      = document.getElementById('contact-form') as HTMLFormElement
  const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement
  const statusEl  = document.getElementById('form-status')!

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const name    = (document.getElementById('name')         as HTMLInputElement).value.trim()
    const email   = (document.getElementById('email')        as HTMLInputElement).value.trim()
    const type    = (document.getElementById('project-type') as HTMLSelectElement).value
    const message = (document.getElementById('message')      as HTMLTextAreaElement).value.trim()

    if (!name || !email || !message) {
      statusEl.textContent = 'Please fill in all required fields.'
      statusEl.className   = 'mt-3 text-sm text-[var(--color-rose)]'
      return
    }

    submitBtn.disabled   = true
    submitBtn.textContent = 'Sending...'
    statusEl.textContent = ''

    try {
      const res  = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, type, message }),
      })
      const json = await res.json() as { ok: boolean; error?: string }

      if (json.ok) {
        statusEl.textContent = "Message sent — I'll be in touch soon."
        statusEl.className   = 'mt-3 text-sm text-[var(--color-emerald)]'
        form.reset()
      } else {
        throw new Error(json.error || 'Send failed')
      }
    } catch {
      const subject = encodeURIComponent(`Portfolio Inquiry — ${type || 'Project'} from ${name}`)
      const body    = encodeURIComponent(`Name: ${name}\nEmail: ${email}\nType: ${type}\n\n${message}`)
      window.location.href = `mailto:Mr.Jwswain@gmail.com?subject=${subject}&body=${body}`
    } finally {
      submitBtn.disabled   = false
      submitBtn.textContent = 'Send Message'
    }
  })
</script>
