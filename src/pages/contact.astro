---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Contact Jeremy Swain — AI Developer & Automation Engineer"
  description="Hire Jeremy Swain for AI development, automation engineering, LLM integration, or business analysis. Based in Atlanta, GA. Call, email, or connect on LinkedIn."
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-20">
    <div class="max-w-2xl mb-16">
      <p class="section-label">Get in Touch</p>
      <h1 class="text-4xl sm:text-5xl font-black mb-5">
        Let's Build<br /><span class="gradient-text">Something Real</span>
      </h1>
      <p class="text-[var(--color-dim)] text-lg leading-relaxed">
        Whether it's a scoped AI project, an automation consulting engagement, or a full-time
        role — I'd like to hear what you're working on.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Direct contact -->
      <div>
        <p class="section-label">Direct</p>
        <h2 class="text-2xl font-black mb-8">
          Fastest Ways to <span class="gradient-text">Reach Me</span>
        </h2>

        <div class="space-y-4">
          <a
            href="tel:+14046407734"
            class="card p-5 flex items-center gap-5 group hover:border-[var(--color-border-glow)] transition-all"
            aria-label="Call Jeremy Swain at (404) 640-7734"
          >
            <div class="w-12 h-12 rounded-xl bg-[var(--color-cyan-dim)] flex items-center justify-center shrink-0 group-hover:bg-[rgba(0,212,255,0.2)] transition-colors">
              <svg class="w-5 h-5 text-[var(--color-cyan)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-[var(--color-text)]">Call or Text</p>
              <p class="text-[var(--color-cyan)] font-mono text-lg">(404) 640-7734</p>
              <p class="text-xs text-[var(--color-muted)]">Atlanta, GA · Available EST</p>
            </div>
          </a>

          <a
            href="mailto:Mr.Jwswain@gmail.com"
            class="card p-5 flex items-center gap-5 group hover:border-[var(--color-border-glow)] transition-all"
            aria-label="Email Jeremy Swain at Mr.Jwswain@gmail.com"
          >
            <div class="w-12 h-12 rounded-xl bg-[var(--color-purple-dim)] flex items-center justify-center shrink-0 group-hover:bg-[rgba(139,92,246,0.2)] transition-colors">
              <svg class="w-5 h-5 text-[var(--color-purple)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-[var(--color-text)]">Email</p>
              <p class="text-[var(--color-purple)] font-mono">Mr.Jwswain@gmail.com</p>
              <p class="text-xs text-[var(--color-muted)]">Best for detailed project descriptions</p>
            </div>
          </a>

          <a
            href="https://www.linkedin.com/in/mrjwswain/"
            target="_blank"
            rel="noopener noreferrer"
            class="card p-5 flex items-center gap-5 group hover:border-[var(--color-border-glow)] transition-all"
            aria-label="Connect with Jeremy Swain on LinkedIn"
          >
            <div class="w-12 h-12 rounded-xl bg-[rgba(10,102,194,0.15)] flex items-center justify-center shrink-0 group-hover:bg-[rgba(10,102,194,0.25)] transition-colors">
              <svg class="w-5 h-5 text-[#0a66c2]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-[var(--color-text)]">LinkedIn</p>
              <p class="text-[#0a66c2] font-medium">linkedin.com/in/mrjwswain</p>
              <p class="text-xs text-[var(--color-muted)]">Connect professionally</p>
            </div>
          </a>
        </div>

        <!-- Availability -->
        <div class="card p-5 mt-6 border-[var(--color-border-glow)]">
          <div class="flex items-center gap-2 mb-3">
            <div class="w-2 h-2 rounded-full bg-[var(--color-emerald)] animate-pulse" aria-hidden="true"></div>
            <span class="text-sm font-semibold text-[var(--color-emerald)]">Available Now</span>
          </div>
          <p class="text-sm text-[var(--color-muted)]">
            Currently accepting new projects, consulting engagements, and full-time opportunities.
            Based in Atlanta, GA. Open to remote work.
          </p>
        </div>
      </div>

      <!-- Inquiry form (mailto-based) -->
      <div>
        <p class="section-label">Inquire</p>
        <h2 class="text-2xl font-black mb-8">
          Describe Your <span class="gradient-text">Project</span>
        </h2>

        <form
          id="contact-form"
          class="space-y-5"
          novalidate
        >
          <div>
            <label for="name" class="block text-sm font-medium text-[var(--color-dim)] mb-1.5">Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              placeholder="Your name"
              class="w-full px-4 py-3 rounded-lg bg-[var(--color-card)] border border-[var(--color-border)] text-[var(--color-text)] placeholder:text-[var(--color-muted)] focus:outline-none focus:border-[var(--color-cyan)] transition-colors text-sm"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-[var(--color-dim)] mb-1.5">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              placeholder="your@email.com"
              class="w-full px-4 py-3 rounded-lg bg-[var(--color-card)] border border-[var(--color-border)] text-[var(--color-text)] placeholder:text-[var(--color-muted)] focus:outline-none focus:border-[var(--color-cyan)] transition-colors text-sm"
            />
          </div>
          <div>
            <label for="project-type" class="block text-sm font-medium text-[var(--color-dim)] mb-1.5">Project Type</label>
            <select
              id="project-type"
              name="type"
              class="w-full px-4 py-3 rounded-lg bg-[var(--color-card)] border border-[var(--color-border)] text-[var(--color-text)] focus:outline-none focus:border-[var(--color-cyan)] transition-colors text-sm"
            >
              <option value="">Select a category...</option>
              <option value="AI Development">AI Development</option>
              <option value="Automation Engineering">Automation Engineering</option>
              <option value="LLM Integration">LLM Integration</option>
              <option value="AI Consulting">AI Strategy & Consulting</option>
              <option value="Business Analysis">Business Analysis</option>
              <option value="Full-Time Role">Full-Time Role</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-[var(--color-dim)] mb-1.5">Project Description</label>
            <textarea
              id="message"
              name="message"
              rows={5}
              required
              placeholder="Describe your project or challenge. What's the problem you're trying to solve? What's the expected outcome?"
              class="w-full px-4 py-3 rounded-lg bg-[var(--color-card)] border border-[var(--color-border)] text-[var(--color-text)] placeholder:text-[var(--color-muted)] focus:outline-none focus:border-[var(--color-cyan)] transition-colors text-sm resize-none"
            ></textarea>
          </div>
          <button
            type="submit"
            class="btn-primary w-full justify-center py-3.5"
          >
            Send Message
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement
  form.addEventListener('submit', (e) => {
    e.preventDefault()
    const name = (document.getElementById('name') as HTMLInputElement).value.trim()
    const email = (document.getElementById('email') as HTMLInputElement).value.trim()
    const type = (document.getElementById('project-type') as HTMLSelectElement).value
    const message = (document.getElementById('message') as HTMLTextAreaElement).value.trim()

    if (!name || !email || !message) return

    const subject = encodeURIComponent(`Portfolio Inquiry — ${type || 'Project'} from ${name}`)
    const body = encodeURIComponent(
      `Name: ${name}\nEmail: ${email}\nType: ${type || 'Not specified'}\n\n${message}`
    )
    window.location.href = `mailto:Mr.Jwswain@gmail.com?subject=${subject}&body=${body}`
  })
</script>
