---
import BaseLayout from '../layouts/BaseLayout.astro'
import SpiderWebBg from '../components/backgrounds/SpiderWebBg'
import PlasmaBg from '../components/backgrounds/PlasmaBg'
import HeroVideo from '../components/HeroVideo.astro'
import { skillCategories, coreCompetencies } from '../data/skills'
---

<BaseLayout
  title="Resume — Mr. Swain AI Developer & Automation Engineer"
  description="Mr. Swain's professional resume — AI Developer, Automation Engineer, LLM Integration Specialist, Business Analyst. Atlanta, GA. Available for contracts and full-time roles."
>

  <!-- Hero (dark) — no-print so it doesn't appear on PDF -->
  <section class="section-dark relative overflow-hidden no-print min-h-[80vh] flex items-center" aria-label="Resume hero">
    <HeroVideo src="/videos/hero-resume.mp4" />
    <SpiderWebBg client:only="react" />
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 py-20 lg:py-28">
      <div class="max-w-2xl">
        <p class="section-label">Resume</p>
        <h1 class="text-5xl sm:text-6xl font-black mb-6 text-[var(--color-text)]">
          Mr. Swain<br /><span class="gradient-text">AI Developer</span>
        </h1>
        <p class="text-[var(--color-dim)] text-xl leading-relaxed">
          AI Developer · Automation Engineer · LLM Integration Specialist · Atlanta, GA
        </p>
      </div>
    </div>
  </section>

  <!-- Resume content (dark) -->
  <section class="section-dark relative overflow-hidden">
    <PlasmaBg client:only="react" />
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 py-10">

      <!-- Actions -->
      <div class="flex justify-end gap-3 mb-8 no-print">
        <button
          onclick="window.print()"
          class="btn-outline text-sm"
          aria-label="Print resume"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
          </svg>
          Print / Save PDF
        </button>
        <a href="/contact" class="btn-primary text-sm">Contact</a>
      </div>

      <!-- Resume card -->
      <div class="card p-8 sm:p-12">

        <!-- Header -->
        <header class="border-b border-[var(--color-border)] pb-8 mb-8">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-6">
            <div>
              <h1 class="text-3xl sm:text-4xl font-black text-[var(--color-text)] mb-1">
                Mr. Swain
              </h1>
              <p class="gradient-text font-semibold text-lg">
                AI Developer &amp; Automation Engineer
              </p>
              <p class="text-[var(--color-muted)] text-sm mt-1">Atlanta, GA</p>
            </div>
            <div class="text-sm space-y-1.5">
              <a href="tel:+14046407734" class="flex items-center gap-2 text-[var(--color-dim)] hover:text-[var(--color-cyan)] transition-colors">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                (404) 640-7734
              </a>
              <a href="mailto:Mr.Jwswain@gmail.com" class="flex items-center gap-2 text-[var(--color-dim)] hover:text-[var(--color-cyan)] transition-colors">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                Mr.Jwswain@gmail.com
              </a>
              <a href="https://www.linkedin.com/in/mrjwswain/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-[var(--color-dim)] hover:text-[var(--color-cyan)] transition-colors">
                <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                linkedin.com/in/mrjwswain
              </a>
              <a href="https://swain.pro" class="flex items-center gap-2 text-[var(--color-dim)] hover:text-[var(--color-cyan)] transition-colors">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                </svg>
                swain.pro
              </a>
            </div>
          </div>
        </header>

        <!-- Summary -->
        <section class="mb-8" aria-label="Professional summary">
          <h2 class="font-black text-[var(--color-text)] text-lg mb-3 uppercase tracking-wider text-xs text-[var(--color-muted)]">Summary</h2>
          <p class="text-[var(--color-dim)] leading-relaxed">
            AI Developer and Automation Engineer with 7+ years spanning enterprise consulting (Capgemini),
            private AI development, and full-stack product build. Designs and deploys scalable LLM integrations,
            Python automation pipelines, multi-agent workflows, and business intelligence systems. Strong
            technical background combined with business analysis expertise — translates business requirements
            into working, production-grade AI systems. Built and deployed 9+ live domains on Cloudflare.
            Available for AI development contracts, automation consulting, and full-time roles.
          </p>
        </section>

        <!-- Core Competencies -->
        <section class="mb-8" aria-label="Core competencies">
          <h2 class="text-xs font-black text-[var(--color-muted)] uppercase tracking-wider mb-3">Core Competencies</h2>
          <div class="flex flex-wrap gap-2">
            {coreCompetencies.map(c => (
              <span class="px-2.5 py-1 rounded text-xs font-medium text-[var(--color-dim)] bg-white/5 border border-[var(--color-border)]">
                {c}
              </span>
            ))}
          </div>
        </section>

        <hr class="divider mb-8" aria-hidden="true" />

        <!-- Experience -->
        <section class="mb-8" aria-label="Professional experience">
          <h2 class="text-xs font-black text-[var(--color-muted)] uppercase tracking-wider mb-6">Experience</h2>
          <div class="space-y-8">
            {[
              {
                role: 'Webmaster & AI Developer',
                company: 'Empire Tours & Productions',
                location: 'Atlanta, GA',
                period: 'Feb 2025 – Jul 2025',
                highlights: [
                  'Revamped digital infrastructure with AI-powered content personalization and chatbot automation.',
                  'Designed and deployed a GPT-based virtual assistant for customer inquiries and scheduling.',
                  'Automated backend workflows for SEO, analytics, bookings, and content updates.',
                  'Built real-time dashboards for marketing and engagement insights.',
                ],
              },
              {
                role: 'AI Developer / Business Analyst',
                company: 'Private Client',
                location: 'Atlanta, GA',
                period: 'Aug 2022 – Dec 2023',
                highlights: [
                  'Designed and implemented end-to-end AI automations using GPT and LangChain-style workflows.',
                  'Built AI agents for document parsing, lead management, and CRM workflow automation.',
                  'Integrated Python tools with Salesforce pipelines, analytics, and customer reporting.',
                  'Delivered AI strategy aligned with business outcomes. Reduced repetitive work through automation.',
                ],
              },
              {
                role: 'Business Analyst',
                company: 'Capgemini',
                location: 'Atlanta, GA',
                period: 'Apr 2019 – Jul 2022',
                highlights: [
                  'Supported enterprise digital transformation: CRM, automation, dashboards, process modernization.',
                  'Gathered requirements, created user stories, conducted gap analyses, supported Agile delivery.',
                  'Used Jira, Azure DevOps, Salesforce, Power BI, and process documentation.',
                  'Worked with global teams in security-conscious enterprise environments.',
                ],
              },
            ].map(exp => (
              <div>
                <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
                  <div>
                    <h3 class="font-bold text-[var(--color-text)]">{exp.role}</h3>
                    <p class="text-sm text-[var(--color-dim)]">{exp.company} — {exp.location}</p>
                  </div>
                  <span class="text-xs font-mono text-[var(--color-muted)] shrink-0">{exp.period}</span>
                </div>
                <ul class="space-y-1.5 ml-4">
                  {exp.highlights.map(h => (
                    <li class="text-sm text-[var(--color-dim)] list-disc list-inside">{h}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <hr class="divider mb-8" aria-hidden="true" />

        <!-- Technical Skills -->
        <section class="mb-8" aria-label="Technical skills">
          <h2 class="text-xs font-black text-[var(--color-muted)] uppercase tracking-wider mb-5">Technical Skills</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {skillCategories.map(cat => (
              <div>
                <h3 class="text-sm font-semibold text-[var(--color-text)] mb-2 flex items-center gap-1.5">
                  <span aria-hidden="true">{cat.icon}</span>
                  {cat.label}
                </h3>
                <p class="text-xs text-[var(--color-dim)]">
                  {cat.skills.map(s => s.name).join(' · ')}
                </p>
              </div>
            ))}
          </div>
        </section>

        <hr class="divider mb-8" aria-hidden="true" />

        <!-- Education -->
        <section class="mb-8" aria-label="Education">
          <h2 class="text-xs font-black text-[var(--color-muted)] uppercase tracking-wider mb-4">Education</h2>
          <div class="space-y-3">
            {[
              { degree: 'Full Stack Web Development Certificate', school: 'Georgia Institute of Technology' },
              { degree: 'A.A.S., Information Technology', school: 'Chattahoochee Technical College' },
            ].map(edu => (
              <div class="flex flex-wrap justify-between gap-2">
                <div>
                  <p class="font-medium text-sm text-[var(--color-text)]">{edu.degree}</p>
                  <p class="text-xs text-[var(--color-muted)]">{edu.school}</p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <hr class="divider mb-8" aria-hidden="true" />

        <!-- Projects highlight -->
        <section aria-label="Projects">
          <h2 class="text-xs font-black text-[var(--color-muted)] uppercase tracking-wider mb-4">Selected Projects</h2>
          <div class="space-y-3">
            {[
              { name: 'VoiceToWebsite', url: 'voicetowebsite.com', desc: 'Voice-activated AI website generator. Built on TypeScript, React, GPT-4, Cloudflare Workers.' },
              { name: 'MyAppAI', url: 'myappai.net', desc: 'AI-powered SaaS for rapid app scaffolding. TypeScript, React, Firebase, OpenAI, Cloudflare Pages.' },
              { name: 'PlayStoreWizard Pro', url: 'playstorewizard.pro', desc: 'AI-driven ASO platform for Google Play. Automated keyword research, listing generation, rank tracking.' },
              { name: 'LLM Automation Suite', url: 'swain.pro/case-studies/llm-automation-suite', desc: 'Python/GPT-4/LangChain workflow automation. Reduced manual processing 87%, eliminated 40+ hrs/week.' },
            ].map(project => (
              <div class="flex flex-wrap justify-between gap-2">
                <div class="flex-1">
                  <span class="font-medium text-sm text-[var(--color-text)]">{project.name}</span>
                  <span class="text-xs text-[var(--color-muted)] ml-2">— {project.url}</span>
                  <p class="text-xs text-[var(--color-dim)] mt-0.5">{project.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>
  </section>

</BaseLayout>
