{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "ignoreDeprecations": "5.0"
  },
  "include": [
    "src/**/*",
    "src/vite-env.d.ts",
    "public/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
